{
  "name": "alaminn-ai-worker",
  "version": "1.0.0",
  "private": true,
  "description": "AI task executor worker for Alaminn.info — polls queued AiTask records and executes them via z-ai-web-dev-sdk",
  "type": "module",
  "scripts": {
    "dev": "bun --hot index.ts",
    "start": "bun index.ts",
    "dev:bun": "bun --hot index.ts",
    "start:bun": "bun index.ts",
    "dev:node": "npx tsx watch index.ts",
    "start:node": "npx tsx index.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "z-ai-web-dev-sdk": "^0.0.18"
  }
}
