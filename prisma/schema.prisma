// Alaminn.info — Prisma schema
// Premium executive authority platform for Al Aminn

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Identity & Auth ──────────────────────────────────────────────
model User {
  id                    String       @id @default(cuid())
  email                 String       @unique
  name                  String
  role                  String       @default("VIEWER") // SUPER_ADMIN | OWNER | EXECUTIVE_ASSISTANT | CRM_MANAGER | PARTNERSHIP_MANAGER | CONTENT_MANAGER | MARKETING_MANAGER | PROJECT_MANAGER | AI_REVIEWER | SECURITY_AUDITOR | VIEWER
  status                String       @default("active") // active | suspended | inactive
  passwordHash          String?
  passwordResetToken    String?
  passwordResetExpiresAt DateTime?
  lastLoginAt           DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  inquiries             Inquiry[]
  aiTasks               AiTask[]     @relation("AiRequester")
  aiApprovals           AiApproval[]
  auditLogs             AuditLog[]
  tasks                 Task[]
  notes                 Note[]
  documents             Document[]

  @@index([passwordResetToken])
}

model Contact {
  id               String            @id @default(cuid())
  fullName         String
  email            String            @unique
  phone            String?
  whatsapp         String?
  organization     String?
  role             String?
  country          String?
  city             String?
  preferredChannel String? // email | phone | whatsapp
  tags             String? // comma separated
  status           String            @default("active") // active | nurturing | converted | archived
  source           String? // utm source / referral
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  inquiries        Inquiry[]
  opportunities    Opportunity[]
  referrals        StudentReferral[]
  notes            Note[]
  tasks            Task[]
}

model Organization {
  id           String        @id @default(cuid())
  name         String
  type         String? // university | education-business | company | media | partner
  country      String?
  website      String?
  status       String        @default("active")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  partnerships Partnership[]
}

// ─── Inquiries & CRM ──────────────────────────────────────────────
model Inquiry {
  id                 String           @id @default(cuid())
  reference          String           @unique
  type               String // university-partnership | business-consultation | operations-review | sales-strategy | education-advisory | ai-automation | crm-digital | tech-collaboration | personal-branding | speaking | media | student-referral | other
  contactId          String
  contact            Contact          @relation(fields: [contactId], references: [id])
  createdById        String?
  createdBy          User?            @relation(fields: [createdById], references: [id])
  currentChallenge   String?
  desiredOutcome     String?
  timeline           String?
  scope              String?
  existingSystem     String?
  preferredTime      String?
  notes              String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  referralSource     String?
  privacyConsent     Boolean          @default(false)
  commsConsent       Boolean          @default(false)
  marketingConsent   Boolean          @default(false)
  studentDataConsent Boolean          @default(false)
  status             String           @default("new") // new | reviewing | qualified | responded | converted | archived
  ipHash             String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  opportunity        Opportunity?
  referral           StudentReferral?
}

model Opportunity {
  id        String    @id @default(cuid())
  contactId String
  contact   Contact   @relation(fields: [contactId], references: [id])
  inquiryId String?   @unique
  inquiry   Inquiry?  @relation(fields: [inquiryId], references: [id])
  title     String
  value     Int? // estimated value
  currency  String    @default("USD")
  stage     String    @default("new") // new | review-required | qualified | discovery-scheduled | discovery-completed | scope-required | proposal-drafting | proposal-sent | negotiation | approved | in-progress | won | lost | on-hold | archived
  priority  String    @default("medium") // low | medium | high | critical
  closeDate DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Partnership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  type           String? // university-partnership | institutional-collaboration | tech-partner | media
  stage          String       @default("new-institution") // new-institution | initial-review | introductory-contact | meeting-planned | requirements-received | due-diligence | proposal-agreement | internal-approval | active-partnership | on-hold | closed
  alAminnRole    String?
  problemSolved  String?
  status         String       @default("planned") // planned | in-testing | connected | active | on-hold
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model StudentReferral {
  id              String   @id @default(cuid())
  contactId       String
  contact         Contact  @relation(fields: [contactId], references: [id])
  inquiryId       String?  @unique
  inquiry         Inquiry? @relation(fields: [inquiryId], references: [id])
  studentName     String
  interestCountry String?
  interestProgram String?
  consent         Boolean  @default(false)
  stage           String   @default("new-referral") // new-referral | consent-pending | consent-confirmed | sent-to-alo-education | accepted | counselor-assigned | in-progress | converted | closed | duplicate | consent-withdrawn
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  priority    String    @default("medium")
  status      String    @default("open") // open | in-progress | done | overdue | cancelled
  assigneeId  String?
  assignee    User?     @relation(fields: [assigneeId], references: [id])
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id])
  relatedType String? // inquiry | opportunity | partnership | project | ai-task
  relatedId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  body      String
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  interest  String? // executive | operations | education | technology | partnership | student | other
  consent   Boolean  @default(false)
  status    String   @default("pending") // pending | confirmed | unsubscribed
  token     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Content ──────────────────────────────────────────────────────
model Project {
  id               String    @id @default(cuid())
  slug             String    @unique
  name             String
  subtitle         String?
  category         String // education | ai | software | crm | automation | marketing | research | professional-brand | client-work
  shortDescription String
  fullDescription  String
  businessProblem  String?
  approvedRole     String?
  responsibilities String?
  solution         String?
  architecture     String?
  technologies     String? // comma separated
  workflows        String?
  outputs          String?
  outcomes         String?
  evidenceStatus   String    @default("unverified") // unverified | evidence-uploaded | under-review | verified | expired | rejected | archived
  confidentiality  String    @default("public") // public | partially-anonymized | fully-anonymized | summary-only | private
  status           String    @default("planned") // planned | in-testing | connected | active | on-hold
  approvedUrl      String?
  logo             String?
  coverMedia       String?
  gallery          String? // comma separated
  featured         Boolean   @default(false)
  visibility       String    @default("public") // public | private
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Article {
  id                 String   @id @default(cuid())
  slug               String   @unique
  title              String
  summary            String
  body               String
  category           String // executive-leadership | business-operations | sales-growth | international-education | university-partnerships | bangladesh-market | ai-automation | crm-technology | digital-marketing | personal-branding | professional-development
  tags               String? // comma separated
  author             String   @default("Al Aminn")
  readingMinutes     Int      @default(5)
  verificationStatus String   @default("verified")
  status             String   @default("published") // draft | review | approved | scheduled | published | archived
  publishedAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt
  featured           Boolean  @default(false)
  coverMedia         String?
}

model Resource {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  category    String // operations | sales | education-business | university-partnerships | ai-readiness | crm-planning | digital-transformation | bangladesh-market | personal-branding | professional-growth | study-abroad
  type        String // guide | template | checklist | report | video | download
  fileUrl     String?
  readTime    Int      @default(5)
  status      String   @default("published")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ImpactRecord {
  id              String   @id @default(cuid())
  category        String // operational-transformation | sales-workflow | student-journey | partnership-development | automation-systems | crm-implementation | team-accountability | platform-development
  challenge       String
  role            String
  action          String
  outcome         String
  evidenceStatus  String   @default("verified")
  confidentiality String   @default("summary-only")
  projectId       String?
  date            DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CaseStudy {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  category        String // education-operations | ai-crm | sales-growth
  context         String
  challenge       String
  role            String
  intervention    String
  systemBuilt     String
  outcome         String
  evidenceStatus  String   @default("verified")
  confidentiality String   @default("summary-only")
  readTime        Int      @default(8)
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── AI Workspace ─────────────────────────────────────────────────
model AiTask {
  id               String       @id @default(cuid())
  requesterId      String
  requester        User         @relation("AiRequester", fields: [requesterId], references: [id])
  workflow         String // executive-linkedin-post | seo-article-draft | newsletter-draft | case-study-draft | partnership-proposal | university-research-brief | operations-audit | sales-process-review | crm-requirements-draft | presentation-outline | speaking-notes | media-response | monthly-authority-report | competitor-research | resource-checklist | risk-review | brand-consistency-audit ...
  project          String?
  objective        String
  prompt           String
  sensitivity      String       @default("internal") // public | internal | confidential
  outputFormat     String       @default("markdown")
  approvalRequired Boolean      @default(true)
  reviewerId       String?
  deadline         DateTime?
  status           String       @default("draft") // draft | validation | queued | accepted | researching | processing | quality-review | safety-review | awaiting-approval | revision-requested | approved | rejected | delivered | failed | cancelled
  result           String?
  createdAt        DateTime     @default(now())
  completedAt      DateTime?
  approvals        AiApproval[]
}

model AiApproval {
  id         String   @id @default(cuid())
  taskId     String
  task       AiTask   @relation(fields: [taskId], references: [id])
  reviewerId String?
  reviewer   User?    @relation(fields: [reviewerId], references: [id])
  decision   String? // approved | rejected | revision
  note       String?
  createdAt  DateTime @default(now())
}

// ─── Audit & Logs ─────────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  resource   String?
  resourceId String?
  meta       String?
  ipHash     String?
  createdAt  DateTime @default(now())
}

model SystemHealth {
  id        String   @id @default(cuid())
  component String
  status    String // ok | degraded | down
  message   String?
  checkedAt DateTime @default(now())
}

// ─── Meeting Requests ─────────────────────────────────────────────
model MeetingRequest {
  id            String   @id @default(cuid())
  reference     String   @unique
  meetingType   String // discovery | strategy | partnership | education
  requestedDate DateTime // the date the user picked
  requestedTime String // HH:mm in Asia/Dhaka
  timezone      String   @default("Asia/Dhaka")
  contactName   String
  contactEmail  String
  organization  String?
  topic         String?
  status        String   @default("new") // new | confirmed | rescheduled | cancelled | completed
  ipHash        String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  notes         String? // admin notes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Privacy-Friendly Analytics ───────────────────────────────────
// First-party, cookie-less, privacy-friendly event log.
// - No personal identifiers (no raw IP, no user ID, no email).
// - ipHash is a sha256 hash truncated to 16 hex chars — never the raw IP.
// - sessionId is a daily-rotating anonymous ID (date + random suffix)
//   stored in localStorage, NOT in cookies.
// - utm_* fields capture marketing attribution (provided client-side).
// - meta is a JSON string for event-specific data (depth, href, etc.).
model AnalyticsEvent {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  eventName   String
  page        String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  sessionId   String? // anonymous, rotated daily, no personal data
  ipHash      String? // sha256 hash, never the raw IP
  meta        String? // JSON string for event-specific data

  @@index([eventName, createdAt])
  @@index([createdAt])
}

// ─── Document Management ──────────────────────────────────────────
model Document {
  id           String   @id @default(cuid())
  title        String
  fileName     String
  fileUrl      String
  mimeType     String?
  size         Int?
  category     String? // contract | proposal | report | legal | financial | media | other
  description  String?
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([createdAt])
}

// ─── Knowledge Base (for AI retrieval) ─────────────────────────────
model KnowledgeChunk {
  id         String   @id @default(cuid())
  documentId String
  content    String
  embedding  Json?
  chunkIndex Int
  status     String   @default("indexed") // indexed | pending | failed
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([documentId])
  @@index([chunkIndex])
  @@index([status])
}

// ─── Notifications ────────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String?
  type      String // inquiry | meeting | ai-task | approval | system | contact | newsletter
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

// ─── Site Settings / SEO ──────────────────────────────────────────
// Generic key-value store for site-level configuration (SEO meta,
// maintenance mode flag, robots.txt overrides, etc).
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Media Library ────────────────────────────────────────────────
model MediaAsset {
  id        String   @id @default(cuid())
  filename  String
  url       String
  altText   String?
  mimeType  String?
  size      Int?
  width     Int?
  height    Int?
  category  String? // brand | portrait | project | article | case-study | general
  createdAt DateTime @default(now())

  @@index([category])
  @@index([createdAt])
}

// ══════════════════════════════════════════════════════════════════
// HIGHER STUDY PLATFORM — Universities, Courses, Scholarships, Research
// ══════════════════════════════════════════════════════════════════
// Added per Higher Study master prompt §42. All models prefixed with
// HigherStudy to avoid collisions with existing Project/Resource models.

// ─── Study Destinations ───────────────────────────────────────────
model HigherStudyCountry {
  id                     String                   @id @default(cuid())
  slug                   String                   @unique // uk, usa, canada, australia...
  name                   String
  officialName           String?
  region                 String? // Europe | North America | Asia-Pacific | Middle East
  overview               String?
  educationSystem        String?
  studyLevels            String? // comma-separated
  popularSubjects        String? // comma-separated
  tuitionFeeRange        String?
  livingCostRange        String?
  majorStudentCities     String? // comma-separated
  admissionRequirements  String?
  englishRequirements    String?
  availableIntakes       String?
  applicationDeadlines   String?
  scholarshipsAvailable  Boolean                  @default(true)
  researchOpportunities  Boolean                  @default(true)
  studentVisaOverview    String?
  financialEvidence      String?
  workRights             String?
  postStudyOpportunities String?
  accommodation          String?
  healthcare             String?
  transport              String?
  studentSafety          String?
  culturalInfo           String?
  applicationProcess     String?
  requiredDocuments      String?
  faq                    String? // JSON string
  officialSources        String? // JSON string
  imageUrl               String?
  flagEmoji              String?
  status                 String                   @default("published") // draft | pending-review | approved | published | needs-update | archived
  lastVerifiedAt         DateTime?
  lastVerifiedBy         String?
  officialSourceUrl      String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  cities                 HigherStudyCity[]
  universities           HigherStudyUniversity[]
  courses                HigherStudyCourse[]
  scholarships           HigherStudyScholarship[]

  @@index([region])
  @@index([status])
}

model HigherStudyCity {
  id            String                  @id @default(cuid())
  slug          String                  @unique
  name          String
  countryId     String
  country       HigherStudyCountry      @relation(fields: [countryId], references: [id], onDelete: Cascade)
  overview      String?
  livingCost    String?
  transport     String?
  accommodation String?
  studentLife   String?
  status        String                  @default("published")
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  universities  HigherStudyUniversity[]

  @@index([countryId])
}

// ─── Universities ──────────────────────────────────────────────────
model HigherStudyUniversity {
  id                           String                       @id @default(cuid())
  slug                         String                       @unique
  officialName                 String
  alternativeNames             String? // comma-separated
  overview                     String?
  establishedYear              Int?
  institutionType              String? // public | private | specialist | conservatoire | research-intensive | modern
  countryId                    String
  country                      HigherStudyCountry           @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cityId                       String?
  city                         HigherStudyCity?             @relation(fields: [cityId], references: [id])
  campusLocations              String?
  officialWebsite              String?
  contactEmail                 String?
  contactPhone                 String?
  availableIntakes             String?
  studyLevels                  String? // comma-separated list of supported levels
  undergraduateCount           Int?
  postgraduateCount            Int?
  hasMBA                       Boolean                      @default(false)
  hasMRes                      Boolean                      @default(false)
  hasMPhil                     Boolean                      @default(false)
  hasPhD                       Boolean                      @default(false)
  hasProfessionalDoctorate     Boolean                      @default(false)
  researchDepartments          String? // comma-separated
  researchStrengths            String?
  tuitionFeeRange              String?
  depositInfo                  String?
  academicEntryRequirements    String?
  countrySpecificRequirements  String?
  ieltsRequirement             String?
  ieltsUkviRequirement         String?
  pteRequirement               String?
  toeflRequirement             String?
  duolingoRequirement          String?
  languageCertRequirement      String?
  oxfordElltRequirement        String?
  englishWaiverPolicy          String?
  workExperienceRequired       Boolean                      @default(false)
  portfolioRequired            Boolean                      @default(false)
  interviewRequired            Boolean                      @default(false)
  applicationDeadlines         String?
  accommodationOptions         String?
  estimatedLivingCosts         String?
  internationalStudentServices String?
  disabilitySupport            String?
  careerSupport                String?
  graduateOutcomes             String?
  graduateRouteGuidance        String?
  applicationGuidance          String?
  officialLinks                String? // JSON string of {label, url}[]
  rankingsJson                 String? // JSON string of {provider, year, category, rank, source}[]
  logoUrl                      String?
  featured                     Boolean                      @default(false)
  verificationStatus           String                       @default("pending-review") // draft | pending-review | verified | published | needs-update | archived
  publicationStatus            String                       @default("published")
  lastVerifiedAt               DateTime?
  lastVerifiedBy               String?
  officialSourceUrl            String?
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  courses                      HigherStudyCourse[]
  scholarships                 HigherStudyScholarship[]
  researchProjects             HigherStudyResearchProject[]
  supervisors                  HigherStudySupervisor[]

  @@index([countryId])
  @@index([cityId])
  @@index([featured])
  @@index([verificationStatus])
  @@index([publicationStatus])
}

// ─── Subjects ─────────────────────────────────────────────────────
model HigherStudySubject {
  id          String              @id @default(cuid())
  slug        String              @unique
  name        String
  category    String? // STEM | Business | Humanities | Arts | Social Sciences | Medicine | Law
  description String?
  iconUrl     String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  courses     HigherStudyCourse[]

  @@index([category])
}

// ─── Intakes ──────────────────────────────────────────────────────
model HigherStudyIntake {
  id                  String              @id @default(cuid())
  slug                String              @unique // fall-2026, spring-2027
  name                String // Fall 2026 (Sep–Oct)
  startDate           DateTime?
  endDate             DateTime?
  applicationDeadline DateTime?
  status              String              @default("open") // open | closed | upcoming
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  courses             HigherStudyCourse[]

  @@index([status])
  @@index([applicationDeadline])
}

// ─── Courses ──────────────────────────────────────────────────────
model HigherStudyCourse {
  id                          String                @id @default(cuid())
  slug                        String                @unique
  title                       String
  universityId                String
  university                  HigherStudyUniversity @relation(fields: [universityId], references: [id], onDelete: Cascade)
  countryId                   String?
  country                     HigherStudyCountry?   @relation(fields: [countryId], references: [id])
  subjectId                   String?
  subject                     HigherStudySubject?   @relation(fields: [subjectId], references: [id])
  studyLevel                  String // foundation | international-year-one | diploma | hnd | bachelors | bachelors-topup | graduate-certificate | graduate-diploma | pre-masters | masters | mba | executive-mba | msc | ma | llm | meng | march | mph | mpa | mres | mphil | phd | dba | edd | dprof | engineering-doctorate | postdoc | research-fellowship | online | distance | blended | executive-education | professional-cert
  qualification               String? // BSc, MSc, MBA, PhD, etc.
  specialisation              String?
  overview                    String?
  modules                     String? // JSON string of module list
  duration                    String? // "1 year full-time"
  studyMode                   String? // full-time | part-time | online | blended
  tuitionFee                  Int? // in USD
  tuitionCurrency             String                @default("USD")
  otherCosts                  String?
  scholarshipAvailable        Boolean               @default(false)
  academicEntryRequirements   String?
  countrySpecificRequirements String?
  englishRequirements         String?
  workExperienceRequired      Boolean               @default(false)
  portfolioRequired           Boolean               @default(false)
  interviewRequired           Boolean               @default(false)
  careerOutcomes              String?
  placementInfo               String?
  researchComponent           String?
  applicationDeadline         String?
  requiredDocuments           String?
  intakeId                    String?
  intake                      HigherStudyIntake?    @relation(fields: [intakeId], references: [id])
  officialSourceUrl           String?
  verificationStatus          String                @default("pending-review")
  publicationStatus           String                @default("published")
  lastVerifiedAt              DateTime?
  lastVerifiedBy              String?
  featured                    Boolean               @default(false)
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt

  @@index([universityId])
  @@index([countryId])
  @@index([subjectId])
  @@index([studyLevel])
  @@index([intakeId])
  @@index([featured])
  @@index([verificationStatus])
}

// ─── Scholarships ─────────────────────────────────────────────────
model HigherStudyScholarship {
  id                     String                 @id @default(cuid())
  slug                   String                 @unique
  name                   String
  provider               String? // university | government | research-council | private
  countryId              String?
  country                HigherStudyCountry?    @relation(fields: [countryId], references: [id])
  universityId           String?
  university             HigherStudyUniversity? @relation(fields: [universityId], references: [id])
  eligibleStudyLevels    String? // comma-separated
  eligibleSubjects       String? // comma-separated
  eligibleNationalities  String? // comma-separated
  fundingType            String? // fully-funded | partially-funded | government | university | department | research-council | merit | need | country-specific | subject-specific | women | leadership | sports | disability | phd-studentship | research-assistantship | teaching-assistantship | tuition-discount | fee-waiver | bursary | grant | fellowship | travel | living-cost
  fundingAmount          String?
  tuitionCoverage        Boolean                @default(false)
  livingCostCoverage     Boolean                @default(false)
  travelSupport          Boolean                @default(false)
  healthInsurance        Boolean                @default(false)
  otherBenefits          String?
  eligibilityCriteria    String?
  academicRequirement    String?
  englishRequirement     String?
  workExperienceRequired Boolean                @default(false)
  requiredDocuments      String?
  openingDate            DateTime?
  deadline               DateTime?
  applicationProcess     String?
  selectionProcess       String?
  restrictions           String?
  officialSourceUrl      String?
  verificationStatus     String                 @default("pending-review")
  publicationStatus      String                 @default("published")
  lastVerifiedAt         DateTime?
  lastVerifiedBy         String?
  featured               Boolean                @default(false)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([countryId])
  @@index([universityId])
  @@index([fundingType])
  @@index([deadline])
  @@index([featured])
  @@index([verificationStatus])
}

// ─── Research Areas ───────────────────────────────────────────────
model HigherStudyResearchArea {
  id               String                       @id @default(cuid())
  slug             String                       @unique
  name             String
  description      String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  researchProjects HigherStudyResearchProject[]
  supervisors      HigherStudySupervisor[]

  @@index([name])
}

// ─── PhD / Research Projects ──────────────────────────────────────
model HigherStudyResearchProject {
  id                   String                   @id @default(cuid())
  slug                 String                   @unique
  title                String
  universityId         String
  university           HigherStudyUniversity    @relation(fields: [universityId], references: [id], onDelete: Cascade)
  department           String?
  researchGroupId      String?
  researchAreaId       String?
  researchArea         HigherStudyResearchArea? @relation(fields: [researchAreaId], references: [id])
  supervisorId         String?
  supervisor           HigherStudySupervisor?   @relation(fields: [supervisorId], references: [id])
  coSupervisorId       String?
  projectSummary       String?
  researchObjectives   String?
  methodologySummary   String?
  candidateProfile     String?
  academicRequirements String?
  englishRequirements  String?
  fundingStatus        String? // fully-funded | partially-funded | self-funded | studentship | unfunded
  tuitionCoverage      Boolean                  @default(false)
  stipend              String?
  additionalFunding    String?
  duration             String?
  startDate            DateTime?
  applicationDeadline  DateTime?
  requiredDocuments    String?
  applicationProcess   String?
  officialSourceUrl    String?
  verificationStatus   String                   @default("pending-review")
  publicationStatus    String                   @default("published")
  lastVerifiedAt       DateTime?
  lastVerifiedBy       String?
  featured             Boolean                  @default(false)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([universityId])
  @@index([researchAreaId])
  @@index([supervisorId])
  @@index([fundingStatus])
  @@index([applicationDeadline])
  @@index([featured])
}

// ─── Supervisors ──────────────────────────────────────────────────
model HigherStudySupervisor {
  id                   String                       @id @default(cuid())
  slug                 String                       @unique
  name                 String
  academicTitle        String? // Professor, Dr, Lecturer
  universityId         String
  university           HigherStudyUniversity        @relation(fields: [universityId], references: [id], onDelete: Cascade)
  department           String?
  publicProfileUrl     String?
  researchAreaId       String?
  researchArea         HigherStudyResearchArea?     @relation(fields: [researchAreaId], references: [id])
  researchInterests    String? // comma-separated
  selectedPublications String? // JSON string
  currentProjects      String? // JSON string
  acceptingStudents    Boolean                      @default(false)
  applicationGuidance  String?
  verificationStatus   String                       @default("pending-review")
  publicationStatus    String                       @default("published")
  lastVerifiedAt       DateTime?
  lastVerifiedBy       String?
  officialSourceUrl    String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  researchProjects     HigherStudyResearchProject[]

  @@index([universityId])
  @@index([researchAreaId])
  @@index([acceptingStudents])
  @@index([verificationStatus])
}

// ─── Study Resources ──────────────────────────────────────────────
model HigherStudyResource {
  id                      String    @id @default(cuid())
  slug                    String    @unique
  title                   String
  category                String? // planning | country-guides | university-guides | course-selection | scholarship-guides | phd-guides | research-guides | proposal-guides | supervisor-contact | sop | personal-statement | cv | recommendation-letter | portfolio | visa | financial | accommodation | pre-departure | student-life | checklists | interview | ielts | ielts-ukvi | pte | toefl | duolingo | languagecert | academic-writing | research-methods | publication | referencing | research-ethics | comparison | faq
  summary                 String?
  content                 String? // markdown body
  author                  String?
  reviewer                String?
  publishedAt             DateTime?
  updatedAt               DateTime  @updatedAt
  lastVerifiedAt          DateTime?
  readingTimeMinutes      Int?
  tableOfContents         String? // JSON string
  relatedUniversitySlugs  String? // comma-separated
  relatedCourseSlugs      String?
  relatedScholarshipSlugs String?
  officialSourceUrl       String?
  verificationStatus      String    @default("pending-review")
  publicationStatus       String    @default("published")
  featured                Boolean   @default(false)
  createdAt               DateTime  @default(now())

  @@index([category])
  @@index([featured])
  @@index([verificationStatus])
  @@index([publishedAt])
}

// ─── Student Stories ──────────────────────────────────────────────
model HigherStudyStudentStory {
  id             String    @id @default(cuid())
  slug           String    @unique
  studentName    String
  universityName String?
  courseName     String?
  country        String?
  intake         String?
  story          String?
  advice         String?
  imageUrl       String?
  publishedAt    DateTime?
  featured       Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([featured])
  @@index([publishedAt])
}

// ─── Events / Webinars ────────────────────────────────────────────
model HigherStudyEvent {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  description     String?
  eventDate       DateTime
  endDate         DateTime?
  location        String? // online | city name
  organiser       String?
  registrationUrl String?
  imageUrl        String?
  status          String    @default("upcoming") // upcoming | live | ended | cancelled
  createdAt       DateTime  @default(now())

  @@index([eventDate])
  @@index([status])
}

// ─── Saved Items (anonymous via session, or authenticated via userId) ─
model HigherStudySavedItem {
  id         String   @id @default(cuid())
  userId     String? // optional — if authenticated alaminn.info user
  sessionId  String? // anonymous session id (localStorage)
  entityType String // university | course | scholarship | research | supervisor | resource | comparison
  entitySlug String
  entityName String
  notes      String?
  createdAt  DateTime @default(now())

  @@unique([userId, entityType, entitySlug])
  @@unique([sessionId, entityType, entitySlug])
  @@index([userId, entityType])
  @@index([sessionId, entityType])
}

// ─── Comparisons ──────────────────────────────────────────────────
model HigherStudyComparison {
  id          String   @id @default(cuid())
  userId      String?
  sessionId   String?
  entityType  String // university | course | scholarship
  entitySlugs String // comma-separated list of slugs (max 4)
  name        String?
  createdAt   DateTime @default(now())

  @@index([userId, entityType])
  @@index([sessionId, entityType])
}

// ─── ALO Education Referral (server-to-server handoff audit) ─────
model HigherStudyReferral {
  id               String    @id @default(cuid())
  referralCode     String    @unique // short-lived signed token
  source           String    @default("ALAMINN_HIGHER_STUDY")
  referralType     String // course-application | university-application | scholarship-application | phd-application | research-application | supervisor-enquiry | eligibility-check | consultation | resource-referral | deadline-alert | english-referral
  targetUrl        String // ALO Education destination URL
  // Public context (safe to put in URL)
  countrySlug      String?
  universitySlug   String?
  courseSlug       String?
  scholarshipSlug  String?
  researchSlug     String?
  supervisorSlug   String?
  studyLevel       String?
  intake           String?
  campaignCode     String?
  // Consent tracking
  consentGiven     Boolean   @default(false)
  consentVersion   String?
  consentTimestamp DateTime?
  // Status
  status           String    @default("created") // created | transferred | completed | failed | expired
  transferredAt    DateTime?
  completedAt      DateTime?
  failureReason    String?
  expiresAt        DateTime? // 24h validity — set by app code (now + 86400000)
  // Audit
  ipHash           String?
  deviceCategory   String? // mobile | tablet | desktop
  createdAt        DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([referralType])
}

// ─── Deadline Alerts ──────────────────────────────────────────────
model HigherStudyAlert {
  id               String    @id @default(cuid())
  userId           String?
  sessionId        String?
  email            String? // optional — for email alerts
  whatsapp         String? // optional — only with explicit consent
  entityType       String // scholarship | research | course | event
  entitySlug       String
  entityName       String
  deadlineDate     DateTime
  alertChannel     String    @default("email") // email | in-app | whatsapp
  alertSent        Boolean   @default(false)
  alertSentAt      DateTime?
  consentGiven     Boolean   @default(false)
  consentTimestamp DateTime?
  status           String    @default("active") // active | fired | cancelled | expired
  createdAt        DateTime  @default(now())

  @@index([userId, status])
  @@index([sessionId, status])
  @@index([deadlineDate])
}

// ─── Audit Log (Higher Study specific) ────────────────────────────
model HigherStudyAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String // create | update | publish | archive | verify | import | delete
  entityType  String
  entityId    String
  entitySlug  String?
  beforeData  String? // JSON string
  afterData   String? // JSON string
  ipHash      String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Import Jobs (bulk university/course/scholarship import) ──────
model HigherStudyImportJob {
  id            String    @id @default(cuid())
  fileName      String
  fileType      String    @default("csv")
  entityType    String // university | course | scholarship | research | supervisor | resource
  totalRows     Int       @default(0)
  processedRows Int       @default(0)
  successRows   Int       @default(0)
  errorRows     Int       @default(0)
  status        String    @default("pending") // pending | preview | importing | completed | failed | cancelled
  dryRun        Boolean   @default(false)
  errors        String? // JSON string of {row, error}[]
  startedAt     DateTime?
  completedAt   DateTime?
  createdBy     String?
  createdAt     DateTime  @default(now())

  @@index([status])
  @@index([entityType])
}

// ─── English Learning platform ────────────────────────────────────
// Parallel to Higher Study — covers English-proficiency courses,
// lessons, practice tests, questions, tutors, resources, enrollments,
// progress tracking and ALO Education referral handoff. All entities
// follow the same verification + publication discipline as Higher Study.

model EnglishLearningCourse {
  id                 String                      @id @default(cuid())
  slug               String                      @unique
  title              String
  summary            String?
  description        String? // markdown
  level              String                      @default("intermediate") // beginner | intermediate | advanced | ielts | toefl | pte | det | gre | gmat
  durationWeeks      Int?
  hoursPerWeek       Int?
  priceUsd           Int?
  currency           String                      @default("USD")
  isFeatured         Boolean                     @default(false)
  isPublished        Boolean                     @default(true)
  verificationStatus String                      @default("pending-review") // draft | pending-review | verified | published | needs-update | archived
  publicationStatus  String                      @default("published") // draft | published | archived
  lastVerifiedAt     DateTime?
  lastVerifiedBy     String?
  officialSourceUrl  String?
  createdByUserId    String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  metaTitle          String?
  metaDescription    String?
  keywords           Json?
  tags               Json?
  heroImageUrl       String?
  introVideoUrl      String?
  syllabus           Json?
  prerequisites      Json?
  targetAudience     Json?
  learningOutcomes   Json?
  certificationType  String?
  passScore          Int?
  enrollmentCount    Int                         @default(0)
  lessons            EnglishLearningLesson[]
  enrollments        EnglishLearningEnrollment[]

  @@index([level])
  @@index([isFeatured])
  @@index([isPublished])
  @@index([verificationStatus])
  @@index([publicationStatus])
}

model EnglishLearningLesson {
  id              String                    @id @default(cuid())
  courseId        String
  course          EnglishLearningCourse     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slug            String                    @unique
  title           String
  summary         String?
  content         String? // markdown
  orderIndex      Int                       @default(0)
  durationMinutes Int?
  lessonType      String                    @default("video") // video | reading | listening | speaking | writing | grammar | vocab | quiz
  videoUrl        String?
  transcript      String? // markdown
  isFreePreview   Boolean                   @default(false)
  isPublished     Boolean                   @default(true)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  progress        EnglishLearningProgress[]

  @@index([courseId])
  @@index([lessonType])
  @@index([isFreePreview])
  @@index([isPublished])
  @@index([orderIndex])
}

model EnglishLearningPracticeTest {
  id              String                    @id @default(cuid())
  slug            String                    @unique
  title           String
  description     String?
  testType        String                    @default("ielts-reading") // ielts-reading | ielts-listening | ielts-writing | ielts-speaking | toefl-reading | toefl-listening | toefl-writing | toefl-speaking | pte | duolingo | gre-verbal | gmat-verbal
  level           String                    @default("intermediate") // beginner | intermediate | advanced | ielts | toefl | pte | det | gre | gmat
  durationMinutes Int?
  totalQuestions  Int                       @default(0)
  passingScore    Int?
  isPublished     Boolean                   @default(true)
  isFeatured      Boolean                   @default(false)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  questions       EnglishLearningQuestion[]
  progress        EnglishLearningProgress[]

  @@index([testType])
  @@index([level])
  @@index([isPublished])
  @@index([isFeatured])
}

model EnglishLearningQuestion {
  id            String                      @id @default(cuid())
  testId        String
  test          EnglishLearningPracticeTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionType  String                      @default("multiple-choice") // multiple-choice | true-false | fill-blank | short-answer | essay | matching
  questionText  String
  options       Json?
  correctAnswer String?
  explanation   String? // markdown
  points        Int                         @default(1)
  orderIndex    Int                         @default(0)
  skillArea     String                      @default("reading") // reading | listening | speaking | writing | grammar | vocab

  @@index([testId])
  @@index([questionType])
  @@index([skillArea])
  @@index([orderIndex])
}

model EnglishLearningTutor {
  id                 String    @id @default(cuid())
  slug               String    @unique
  name               String
  bio                String?
  avatarUrl          String?
  specialties        Json?
  qualifications     Json?
  yearsExperience    Int?
  hourlyRateUsd      Int?
  currency           String    @default("USD")
  rating             Float     @default(0)
  reviewCount        Int       @default(0)
  isAvailable        Boolean   @default(true)
  isPublished        Boolean   @default(true)
  verificationStatus String    @default("pending-review")
  lastVerifiedAt     DateTime?
  officialProfileUrl String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([isAvailable])
  @@index([isPublished])
  @@index([verificationStatus])
  @@index([rating])
}

model EnglishLearningResource {
  id                 String   @id @default(cuid())
  slug               String   @unique
  title              String
  summary            String?
  description        String? // markdown
  resourceType       String   @default("article") // article | video | infographic | audio | pdf
  url                String?
  durationMinutes    Int?
  readingTimeMinutes Int?
  level              String   @default("intermediate")
  isPublished        Boolean  @default(true)
  isFeatured         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  authorName         String?
  sourceName         String?

  @@index([resourceType])
  @@index([level])
  @@index([isPublished])
  @@index([isFeatured])
}

model EnglishLearningEnrollment {
  id              String                    @id @default(cuid())
  userId          String?
  sessionId       String
  courseId        String
  course          EnglishLearningCourse     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status          String                    @default("enrolled") // enrolled | started | completed | abandoned
  progressPercent Int                       @default(0)
  lastAccessedAt  DateTime?
  completedAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  progress        EnglishLearningProgress[]

  @@unique([sessionId, courseId])
  @@index([userId])
  @@index([sessionId])
  @@index([courseId])
  @@index([status])
}

model EnglishLearningProgress {
  id               String                       @id @default(cuid())
  enrollmentId     String
  enrollment       EnglishLearningEnrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId         String?
  lesson           EnglishLearningLesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  testId           String?
  test             EnglishLearningPracticeTest? @relation(fields: [testId], references: [id], onDelete: SetNull)
  status           String                       @default("not-started") // not-started | in-progress | completed
  scorePercent     Int?
  timeSpentMinutes Int                          @default(0)
  lastAttemptAt    DateTime?
  attemptsCount    Int                          @default(0)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@index([enrollmentId])
  @@index([lessonId])
  @@index([testId])
  @@index([status])
}

model EnglishLearningReferral {
  id               String    @id @default(cuid())
  referralCode     String    @unique
  referralType     String    @default("course-package") // course-package | tutor-booking | mock-test-bundle
  sourceEntityId   String?
  sourceEntityType String?
  targetUrl        String
  status           String    @default("created") // created | transferred | completed | failed | expired
  createdAt        DateTime  @default(now())
  completedAt      DateTime?
  ipHash           String?
  userAgent        String?
  notes            Json?

  @@index([status])
  @@index([referralType])
  @@index([createdAt])
}

model EnglishLearningAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  beforeData  Json?
  afterData   Json?
  ipHash      String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}

model EnglishLearningSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("general")
  updatedAt DateTime @updatedAt

  @@index([category])
}

// ══════════════════════════════════════════════════════════════════
// SOCIAL COMMAND CENTER — multi-account social automation (Phase B)
// Loose scalar FKs to User/Contact (no back-relations) to keep this
// migration additive and reversible. JSON payloads stored as String
// per existing schema convention (SQLite-compatible).
// ══════════════════════════════════════════════════════════════════

model SocialAccount {
  id               String    @id @default(cuid())
  platform         String // facebook | whatsapp | instagram | youtube | linkedin | tiktok
  externalId       String // page id / phone_number_id / ig user id
  displayName      String
  username         String?
  status           String    @default("disconnected") // connected | disconnected | expired | error | pending
  capabilities     String? // JSON string[] e.g. ["publish","inbox","comments"]
  tokenEncrypted   String? // AES-256-GCM ciphertext — never returned to client
  tokenExpiresAt   DateTime?
  webhookVerified  Boolean   @default(false)
  automationEnabled Boolean  @default(false)
  responseMode     String    @default("approval") // manual | approval | controlled
  aiProfileId      String?
  assignedUserId   String?
  lastHealthAt     DateTime?
  healthError      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  conversations    SocialConversation[]
  contents         SocialContentTarget[]

  @@unique([platform, externalId])
  @@index([platform])
  @@index([status])
}

model SocialAutomationState {
  id                 String   @id @default("global")
  engagementEnabled  Boolean  @default(false) // global auto-reply switch — default OFF (fail-safe)
  publishingEnabled  Boolean  @default(false)
  generationEnabled  Boolean  @default(true)
  version            Int      @default(1) // optimistic-concurrency / race guard
  changedById        String?
  changedByName      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AiPersonalityProfile {
  id                String   @id @default(cuid())
  name              String
  isDefault         Boolean  @default(false)
  identity          String? // preferred name + professional identity
  brandContext      String?
  languages         String   @default("en,bn") // comma list: en | bn | banglish
  formality         Int      @default(3) // 1 casual .. 5 formal
  friendliness      Int      @default(4) // 1 .. 5
  greeting          String?
  signOff           String?
  sentenceStyle     String? // short | balanced | detailed
  preferredPhrases  String? // JSON string[]
  avoidPhrases      String? // JSON string[]
  servicePrinciples String?
  faqs              String? // JSON [{q,a}]
  businessHours     String?
  escalationContact String?
  platformStyles    String? // JSON {facebook: "...", whatsapp: "..."}
  neverAnswerTopics String? // JSON string[] — always escalate
  examplePairs      String? // JSON [{incoming, approvedReply}]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isDefault])
}

model SocialKnowledgeSource {
  id        String   @id @default(cuid())
  title     String
  category  String   @default("faq") // faq | policy | service | pricing | document
  content   String
  approved  Boolean  @default(false)
  profileId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([approved])
}

model SocialConversation {
  id               String          @id @default(cuid())
  accountId        String
  account          SocialAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform         String
  externalThreadId String // participant id / thread id from provider
  participantId    String
  participantName  String?
  status           String          @default("unread") // unread | pending | resolved | escalated
  priority         String          @default("normal") // low | normal | high | urgent
  assignedUserId   String?
  labels           String? // JSON string[]
  language         String?
  contactId        String? // link to CRM Contact
  unreadCount      Int             @default(0)
  lastMessageAt    DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  messages         SocialMessage[]

  @@unique([accountId, externalThreadId])
  @@index([platform])
  @@index([status])
  @@index([lastMessageAt])
}

model SocialMessage {
  id                String             @id @default(cuid())
  conversationId    String
  conversation      SocialConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  providerMessageId String?
  direction         String // inbound | outbound
  kind              String   @default("message") // message | comment | mention
  senderId          String?
  senderName        String?
  body              String
  mediaUrl          String?
  isOwn             Boolean            @default(false)
  deliveryStatus    String   @default("received") // received | queued | sending | sent | delivered | read | failed | suppressed
  createdAt         DateTime           @default(now())

  @@unique([providerMessageId])
  @@index([conversationId, createdAt])
  @@index([deliveryStatus])
}

model SocialWebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String
  accountId       String?
  payloadHash     String
  status          String    @default("received") // received | processed | duplicate | failed | ignored
  attempts        Int       @default(0)
  error           String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([provider, providerEventId])
  @@index([status])
  @@index([createdAt])
}

model SocialReplyDecision {
  id             String   @id @default(cuid())
  conversationId String
  messageId      String?
  category       String // general | service | lead | appointment | complaint | spam | sensitive | pricing | human-required
  language       String?
  confidence     Float    @default(0)
  risk           String   @default("high") // low | medium | high
  draft          String?
  finalText      String?
  decision       String   @default("held") // auto_sent | held | approved_sent | edited_sent | rejected | escalated | suppressed_off | manual_sent | failed
  reason         String?
  modelUsed      String?
  knowledgeRefs  String? // JSON string[]
  automationVersion Int?  // global switch version observed at decision time
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([conversationId])
  @@index([decision])
  @@index([createdAt])
}

model SocialApproval {
  id          String   @id @default(cuid())
  decisionId  String   @unique
  status      String   @default("pending") // pending | approved | edited_approved | rejected | escalated | resolved
  editedText  String?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model SocialAutomationRule {
  id              String   @id @default(cuid())
  name            String
  accountId       String? // null = all accounts
  platform        String?
  category        String? // null = any category
  action          String   @default("approval") // auto_reply | approval | escalate | ignore
  minConfidence   Float    @default(0.85)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId])
  @@index([enabled])
}

model SocialCampaign {
  id          String   @id @default(cuid())
  name        String
  objective   String?
  pillar      String?
  audience    String?
  status      String   @default("draft") // draft | active | paused | completed
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  contents    SocialContent[]

  @@index([status])
}

model SocialContent {
  id          String   @id @default(cuid())
  campaignId  String?
  campaign    SocialCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  title       String
  body        String
  variants    String? // JSON {platform: body}
  hashtags    String? // JSON string[]
  cta         String?
  mediaUrls   String? // JSON string[]
  language    String   @default("en")
  status      String   @default("draft") // draft | review | approved | scheduled | publishing | published | failed
  scheduledAt DateTime?
  approvedById String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  targets     SocialContentTarget[]

  @@index([status])
  @@index([scheduledAt])
}

model SocialContentTarget {
  id          String        @id @default(cuid())
  contentId   String
  content     SocialContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  accountId   String
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status      String        @default("pending") // pending | publishing | published | failed | suppressed
  providerPostId String?
  error       String?
  attempts    Int           @default(0)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([contentId, accountId])
  @@index([status])
}

// ══════════════════════════════════════════════════════════════════
// HIGHER STUDY — Source registry, 7-day monitoring, change approval
// (additive; production catalogue rows are NEVER mutated by the agent
//  — only via Super Admin approval in the verification queue)
// ══════════════════════════════════════════════════════════════════

model HigherStudyFaculty {
  id           String   @id @default(cuid())
  universityId String
  name         String
  type         String   @default("faculty") // faculty | school | department | college | institute
  parentId     String?
  officialUrl  String?
  sourceUrl    String?
  lastVerifiedAt DateTime?
  verificationStatus String @default("pending-review")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([universityId])
  @@index([type])
}

model HigherStudyCourseIntake {
  id             String   @id @default(cuid())
  courseId       String
  intakeName     String // e.g. September 2027
  academicYear   String?
  opensAt        DateTime?
  deadline       DateTime?
  intlDeadline   DateTime?
  scholarshipDeadline DateTime?
  startsAt       DateTime?
  rolling        Boolean  @default(false)
  intlConfirmed  Boolean  @default(false)
  sourceUrl      String?
  lastVerifiedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([courseId])
  @@index([deadline])
  @@index([startsAt])
}

model HigherStudySourceRecord {
  id           String   @id @default(cuid())
  url          String   @unique
  owner        String? // university / government body
  sourceType   String   @default("university-course") // university-course | uni-admissions | uni-fees | uni-scholarship | government | immigration | ranking | pdf
  entityType   String? // university | course | scholarship | country | government
  entityId     String?
  countrySlug  String?
  title        String?
  licenseNote  String?
  active       Boolean  @default(true)
  lastCheckedAt DateTime?
  lastStatus   String? // ok | unavailable | parse-error | changed
  failCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([entityType, entityId])
  @@index([active])
  @@index([sourceType])
}

model HigherStudySourceSnapshot {
  id          String   @id @default(cuid())
  sourceId    String
  contentHash String
  title       String?
  signals     String? // JSON extracted signals {fees:[], deadlines:[], ielts:null,...}
  fetchedAt   DateTime @default(now())
  httpStatus  Int?
  @@index([sourceId, fetchedAt])
  @@index([contentHash])
}

model HigherStudyDataChange {
  id             String   @id @default(cuid())
  runId          String?
  sourceId       String?
  entityType     String // university | course | scholarship | government
  entityId       String?
  entityLabel    String?
  field          String?
  changeType     String // NEW_COURSE | COURSE_CLOSED | FEE_CHANGED | DEADLINE_CHANGED | REQUIREMENT_CHANGED | ENGLISH_REQUIREMENT_CHANGED | SCHOLARSHIP_NEW | SCHOLARSHIP_UPDATED | INTAKE_CHANGED | SOURCE_CHANGED | SOURCE_UNAVAILABLE | POSSIBLE_DATA_CONFLICT | NEEDS_MANUAL_REVIEW | OFFICIAL_POLICY_CHANGE | GOVERNMENT_POLICY_CHANGE ...
  impact         String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  oldValue       String?
  newValue       String?
  sourceUrl      String?
  confidence     Float    @default(0)
  aiSummary      String?
  status         String   @default("pending") // pending | approved | rejected | needs-review | recheck-requested
  decidedById    String?
  decidedAt      DateTime?
  detectedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([status])
  @@index([changeType])
  @@index([entityType, entityId])
  @@index([detectedAt])
}

model HigherStudyMonitoringRun {
  id           String   @id @default(cuid()) // also the dedup/lock key per cycle
  status       String   @default("running") // running | completed | failed
  sourcesChecked Int    @default(0)
  sourcesFailed  Int    @default(0)
  changesDetected Int   @default(0)
  error        String?
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  nextRunAt    DateTime?
  @@index([status])
  @@index([startedAt])
}

model HigherStudyOfficialDocument {
  id           String   @id @default(cuid())
  title        String
  sourceUrl    String
  universityId String?
  countrySlug  String?
  category     String   @default("guide") // admission-guide | scholarship-pdf | handbook | policy
  fileHash     String?
  version      Int      @default(1)
  approvalStatus String @default("pending") // pending | approved | rejected
  publishedAt  DateTime?
  discoveredAt DateTime @default(now())
  lastCheckedAt DateTime?
  @@unique([sourceUrl, version])
  @@index([countrySlug])
  @@index([approvalStatus])
}
