// ─── ALO Education Referral (server-to-server handoff audit) ─────
model HigherStudyReferral {
  id               String @db.VarChar(191)    @id @default(cuid())
  referralCode     String @db.VarChar(500)    @unique // short-lived signed token
  source           String @db.VarChar(191)    @default("ALAMINN_HIGHER_STUDY")
  referralType     String @db.VarChar(500) // course-application | university-application | scholarship-application | phd-application | research-application | supervisor-enquiry | eligibility-check | consultation | resource-referral | deadline-alert | english-referral
  targetUrl        String @db.VarChar(500) // ALO Education destination URL
  // Public context (safe to put in URL)
  countrySlug      String? @db.VarChar(500)
  universitySlug   String? @db.VarChar(500)
  courseSlug       String? @db.VarChar(500)
  scholarshipSlug  String? @db.VarChar(500)
  researchSlug     String? @db.VarChar(500)
  supervisorSlug   String? @db.VarChar(500)
  studyLevel       String? @db.VarChar(500)
  intake           String? @db.VarChar(500)
  campaignCode     String? @db.VarChar(500)
  // Consent tracking
  consentGiven     Boolean   @default(false)
  consentVersion   String? @db.VarChar(500)
  consentTimestamp DateTime?
  // Status
  status           String @db.VarChar(191)    @default("created") // created | transferred | completed | failed | expired
  transferredAt    DateTime?
  completedAt      DateTime?
  failureReason    String? @db.VarChar(500)
  expiresAt        DateTime? // 24h validity — set by app code (now + 86400000)
  // Audit
  ipHash           String? @db.VarChar(500)
  deviceCategory   String? @db.VarChar(500) // mobile | tablet | desktop
  createdAt        DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([referralType])
}

