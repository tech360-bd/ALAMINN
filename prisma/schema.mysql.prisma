// Alaminn.info — Prisma schema
// Premium executive authority platform for Al Aminn

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Identity & Auth ──────────────────────────────────────────────
model User {
  id                    String @db.VarChar(191)       @id @default(cuid())
  email                 String @db.VarChar(191)       @unique
  name                  String @db.VarChar(500)
  role                  String @db.VarChar(191)       @default("VIEWER") // SUPER_ADMIN | OWNER | EXECUTIVE_ASSISTANT | CRM_MANAGER | PARTNERSHIP_MANAGER | CONTENT_MANAGER | MARKETING_MANAGER | PROJECT_MANAGER | AI_REVIEWER | SECURITY_AUDITOR | VIEWER
  status                String @db.VarChar(191)       @default("active") // active | suspended | inactive
  passwordHash          String? @db.VarChar(500)
  passwordResetToken    String? @db.VarChar(500)
  passwordResetExpiresAt DateTime?
  lastLoginAt           DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  inquiries             Inquiry[]
  aiTasks               AiTask[]     @relation("AiRequester")
  aiApprovals           AiApproval[]
  auditLogs             AuditLog[]
  tasks                 Task[]
  notes                 Note[]
  documents             Document[]

  @@index([passwordResetToken])
}

model Contact {
  id               String @db.VarChar(191)            @id @default(cuid())
  fullName         String @db.VarChar(500)
  email            String @db.VarChar(191)            @unique
  phone            String? @db.VarChar(500)
  whatsapp         String? @db.VarChar(500)
  organization     String? @db.VarChar(500)
  role             String? @db.VarChar(191)
  country          String? @db.VarChar(500)
  city             String? @db.VarChar(500)
  preferredChannel String? @db.VarChar(500) // email | phone | whatsapp
  tags             String? @db.VarChar(500) // comma separated
  status           String @db.VarChar(191)            @default("active") // active | nurturing | converted | archived
  source           String? @db.VarChar(191) // utm source / referral
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  inquiries        Inquiry[]
  opportunities    Opportunity[]
  referrals        StudentReferral[]
  notes            Note[]
  tasks            Task[]
}

model Organization {
  id           String @db.VarChar(191)        @id @default(cuid())
  name         String @db.VarChar(500)
  type         String? @db.VarChar(191) // university | education-business | company | media | partner
  country      String? @db.VarChar(500)
  website      String? @db.VarChar(500)
  status       String @db.VarChar(191)        @default("active")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  partnerships Partnership[]
}

// ─── Inquiries & CRM ──────────────────────────────────────────────
model Inquiry {
  id                 String @db.VarChar(191)           @id @default(cuid())
  reference          String @db.VarChar(191)           @unique
  type               String @db.VarChar(191) // university-partnership | business-consultation | operations-review | sales-strategy | education-advisory | ai-automation | crm-digital | tech-collaboration | personal-branding | speaking | media | student-referral | other
  contactId          String @db.VarChar(191)
  contact            Contact          @relation(fields: [contactId], references: [id])
  createdById        String? @db.VarChar(191)
  createdBy          User?            @relation(fields: [createdById], references: [id])
  currentChallenge   String? @db.LongText
  desiredOutcome     String? @db.LongText
  timeline           String? @db.VarChar(500)
  scope              String? @db.LongText
  existingSystem     String? @db.LongText
  preferredTime      String? @db.VarChar(500)
  notes              String? @db.LongText
  utmSource          String? @db.VarChar(500)
  utmMedium          String? @db.VarChar(500)
  utmCampaign        String? @db.VarChar(500)
  referralSource     String? @db.VarChar(500)
  privacyConsent     Boolean          @default(false)
  commsConsent       Boolean          @default(false)
  marketingConsent   Boolean          @default(false)
  studentDataConsent Boolean          @default(false)
  status             String @db.VarChar(191)           @default("new") // new | reviewing | qualified | responded | converted | archived
  ipHash             String? @db.VarChar(500)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  opportunity        Opportunity?
  referral           StudentReferral?
}

model Opportunity {
  id        String @db.VarChar(191)    @id @default(cuid())
  contactId String @db.VarChar(191)
  contact   Contact   @relation(fields: [contactId], references: [id])
  inquiryId String? @db.VarChar(191)   @unique
  inquiry   Inquiry?  @relation(fields: [inquiryId], references: [id])
  title     String @db.VarChar(500)
  value     Int? // estimated value
  currency  String @db.VarChar(191)    @default("USD")
  stage     String @db.VarChar(191)    @default("new") // new | review-required | qualified | discovery-scheduled | discovery-completed | scope-required | proposal-drafting | proposal-sent | negotiation | approved | in-progress | won | lost | on-hold | archived
  priority  String @db.VarChar(191)    @default("medium") // low | medium | high | critical
  closeDate DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Partnership {
  id             String @db.VarChar(191)       @id @default(cuid())
  organizationId String @db.VarChar(191)
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String @db.VarChar(500)
  type           String? @db.VarChar(191) // university-partnership | institutional-collaboration | tech-partner | media
  stage          String @db.VarChar(191)       @default("new-institution") // new-institution | initial-review | introductory-contact | meeting-planned | requirements-received | due-diligence | proposal-agreement | internal-approval | active-partnership | on-hold | closed
  alAminnRole    String? @db.VarChar(500)
  problemSolved  String? @db.LongText
  status         String @db.VarChar(191)       @default("planned") // planned | in-testing | connected | active | on-hold
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model StudentReferral {
  id              String @db.VarChar(191)   @id @default(cuid())
  contactId       String @db.VarChar(191)
  contact         Contact  @relation(fields: [contactId], references: [id])
  inquiryId       String? @db.VarChar(191)  @unique
  inquiry         Inquiry? @relation(fields: [inquiryId], references: [id])
  studentName     String @db.VarChar(500)
  interestCountry String? @db.VarChar(500)
  interestProgram String? @db.VarChar(500)
  consent         Boolean  @default(false)
  stage           String @db.VarChar(191)   @default("new-referral") // new-referral | consent-pending | consent-confirmed | sent-to-alo-education | accepted | counselor-assigned | in-progress | converted | closed | duplicate | consent-withdrawn
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Task {
  id          String @db.VarChar(191)    @id @default(cuid())
  title       String @db.VarChar(500)
  description String? @db.LongText
  dueDate     DateTime?
  priority    String @db.VarChar(191)    @default("medium")
  status      String @db.VarChar(191)    @default("open") // open | in-progress | done | overdue | cancelled
  assigneeId  String? @db.VarChar(191)
  assignee    User?     @relation(fields: [assigneeId], references: [id])
  contactId   String? @db.VarChar(191)
  contact     Contact?  @relation(fields: [contactId], references: [id])
  relatedType String? @db.VarChar(500) // inquiry | opportunity | partnership | project | ai-task
  relatedId   String? @db.VarChar(191)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Note {
  id        String @db.VarChar(191)   @id @default(cuid())
  body      String @db.LongText
  contactId String? @db.VarChar(191)
  contact   Contact? @relation(fields: [contactId], references: [id])
  authorId  String? @db.VarChar(191)
  author    User?    @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String @db.VarChar(191)   @id @default(cuid())
  email     String @db.VarChar(191)   @unique
  name      String? @db.VarChar(500)
  interest  String? @db.VarChar(500) // executive | operations | education | technology | partnership | student | other
  consent   Boolean  @default(false)
  status    String @db.VarChar(191)   @default("pending") // pending | confirmed | unsubscribed
  token     String? @db.VarChar(191)  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Content ──────────────────────────────────────────────────────
model Project {
  id               String @db.VarChar(191)    @id @default(cuid())
  slug             String @db.VarChar(191)    @unique
  name             String @db.VarChar(500)
  subtitle         String? @db.VarChar(500)
  category         String @db.VarChar(191) // education | ai | software | crm | automation | marketing | research | professional-brand | client-work
  shortDescription String @db.LongText
  fullDescription  String @db.LongText
  businessProblem  String? @db.LongText
  approvedRole     String? @db.VarChar(500)
  responsibilities String? @db.LongText
  solution         String? @db.LongText
  architecture     String? @db.LongText
  technologies     String? @db.VarChar(500) // comma separated
  workflows        String? @db.LongText
  outputs          String? @db.LongText
  outcomes         String? @db.LongText
  evidenceStatus   String @db.VarChar(191)    @default("unverified") // unverified | evidence-uploaded | under-review | verified | expired | rejected | archived
  confidentiality  String @db.VarChar(191)    @default("public") // public | partially-anonymized | fully-anonymized | summary-only | private
  status           String @db.VarChar(191)    @default("planned") // planned | in-testing | connected | active | on-hold
  approvedUrl      String? @db.VarChar(500)
  logo             String? @db.VarChar(500)
  coverMedia       String? @db.VarChar(500)
  gallery          String? @db.VarChar(500) // comma separated
  featured         Boolean   @default(false)
  visibility       String @db.VarChar(191)    @default("public") // public | private
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Article {
  id                 String @db.VarChar(191)   @id @default(cuid())
  slug               String @db.VarChar(191)   @unique
  title              String @db.VarChar(500)
  summary            String @db.LongText
  body               String @db.LongText
  category           String @db.VarChar(191) // executive-leadership | business-operations | sales-growth | international-education | university-partnerships | bangladesh-market | ai-automation | crm-technology | digital-marketing | personal-branding | professional-development
  tags               String? @db.VarChar(500) // comma separated
  author             String @db.VarChar(500)   @default("Al Aminn")
  readingMinutes     Int      @default(5)
  verificationStatus String @db.VarChar(191)   @default("verified")
  status             String @db.VarChar(191)   @default("published") // draft | review | approved | scheduled | published | archived
  publishedAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt
  featured           Boolean  @default(false)
  coverMedia         String? @db.VarChar(500)
}

model Resource {
  id          String @db.VarChar(191)   @id @default(cuid())
  slug        String @db.VarChar(191)   @unique
  title       String @db.VarChar(500)
  description String @db.LongText
  category    String @db.VarChar(191) // operations | sales | education-business | university-partnerships | ai-readiness | crm-planning | digital-transformation | bangladesh-market | personal-branding | professional-growth | study-abroad
  type        String @db.VarChar(191) // guide | template | checklist | report | video | download
  fileUrl     String? @db.VarChar(500)
  readTime    Int      @default(5)
  status      String @db.VarChar(191)   @default("published")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ImpactRecord {
  id              String @db.VarChar(191)   @id @default(cuid())
  category        String @db.VarChar(191) // operational-transformation | sales-workflow | student-journey | partnership-development | automation-systems | crm-implementation | team-accountability | platform-development
  challenge       String @db.LongText
  role            String @db.VarChar(191)
  action          String @db.VarChar(191)
  outcome         String @db.LongText
  evidenceStatus  String @db.VarChar(191)   @default("verified")
  confidentiality String @db.VarChar(191)   @default("summary-only")
  projectId       String? @db.VarChar(191)
  date            DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CaseStudy {
  id              String @db.VarChar(191)   @id @default(cuid())
  slug            String @db.VarChar(191)   @unique
  title           String @db.VarChar(500)
  category        String @db.VarChar(191) // education-operations | ai-crm | sales-growth
  context         String @db.LongText
  challenge       String @db.LongText
  role            String @db.VarChar(191)
  intervention    String @db.LongText
  systemBuilt     String @db.LongText
  outcome         String @db.LongText
  evidenceStatus  String @db.VarChar(191)   @default("verified")
  confidentiality String @db.VarChar(191)   @default("summary-only")
  readTime        Int      @default(8)
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── AI Workspace ─────────────────────────────────────────────────
model AiTask {
  id               String @db.VarChar(191)       @id @default(cuid())
  requesterId      String @db.VarChar(191)
  requester        User         @relation("AiRequester", fields: [requesterId], references: [id])
  workflow         String @db.VarChar(500) // executive-linkedin-post | seo-article-draft | newsletter-draft | case-study-draft | partnership-proposal | university-research-brief | operations-audit | sales-process-review | crm-requirements-draft | presentation-outline | speaking-notes | media-response | monthly-authority-report | competitor-research | resource-checklist | risk-review | brand-consistency-audit ...
  project          String? @db.VarChar(500)
  objective        String @db.VarChar(500)
  prompt           String @db.LongText
  sensitivity      String @db.VarChar(191)       @default("internal") // public | internal | confidential
  outputFormat     String @db.VarChar(191)       @default("markdown")
  approvalRequired Boolean      @default(true)
  reviewerId       String? @db.VarChar(191)
  deadline         DateTime?
  status           String @db.VarChar(191)       @default("draft") // draft | validation | queued | accepted | researching | processing | quality-review | safety-review | awaiting-approval | revision-requested | approved | rejected | delivered | failed | cancelled
  result           String? @db.LongText
  createdAt        DateTime     @default(now())
  completedAt      DateTime?
  approvals        AiApproval[]
}

model AiApproval {
  id         String @db.VarChar(191)   @id @default(cuid())
  taskId     String @db.VarChar(191)
  task       AiTask   @relation(fields: [taskId], references: [id])
  reviewerId String? @db.VarChar(191)
  reviewer   User?    @relation(fields: [reviewerId], references: [id])
  decision   String? @db.VarChar(191) // approved | rejected | revision
  note       String? @db.VarChar(500)
  createdAt  DateTime @default(now())
}

// ─── Audit & Logs ─────────────────────────────────────────────────
model AuditLog {
  id         String @db.VarChar(191)   @id @default(cuid())
  actorId    String? @db.VarChar(191)
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String @db.VarChar(191)
  resource   String? @db.VarChar(500)
  resourceId String? @db.VarChar(191)
  meta       String? @db.VarChar(500)
  ipHash     String? @db.VarChar(500)
  createdAt  DateTime @default(now())
}

model SystemHealth {
  id        String @db.VarChar(191)   @id @default(cuid())
  component String @db.VarChar(500)
  status    String @db.VarChar(191) // ok | degraded | down
  message   String? @db.VarChar(500)
  checkedAt DateTime @default(now())
}

// ─── Meeting Requests ─────────────────────────────────────────────
model MeetingRequest {
  id            String @db.VarChar(191)   @id @default(cuid())
  reference     String @db.VarChar(191)   @unique
  meetingType   String @db.VarChar(500) // discovery | strategy | partnership | education
  requestedDate DateTime // the date the user picked
  requestedTime String @db.VarChar(500) // HH:mm in Asia/Dhaka
  timezone      String @db.VarChar(500)   @default("Asia/Dhaka")
  contactName   String @db.VarChar(500)
  contactEmail  String @db.VarChar(500)
  organization  String? @db.VarChar(500)
  topic         String? @db.VarChar(500)
  status        String @db.VarChar(191)   @default("new") // new | confirmed | rescheduled | cancelled | completed
  ipHash        String? @db.VarChar(500)
  utmSource     String? @db.VarChar(500)
  utmMedium     String? @db.VarChar(500)
  utmCampaign   String? @db.VarChar(500)
  notes         String? @db.LongText // admin notes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Privacy-Friendly Analytics ───────────────────────────────────
// First-party, cookie-less, privacy-friendly event log.
// - No personal identifiers (no raw IP, no user ID, no email).
// - ipHash is a sha256 hash truncated to 16 hex chars — never the raw IP.
// - sessionId is a daily-rotating anonymous ID (date + random suffix)
//   stored in localStorage, NOT in cookies.
// - utm_* fields capture marketing attribution (provided client-side).
// - meta is a JSON string for event-specific data (depth, href, etc.).
model AnalyticsEvent {
  id          String @db.VarChar(191)   @id @default(cuid())
  createdAt   DateTime @default(now())
  eventName   String @db.VarChar(500)
  page        String? @db.VarChar(500)
  referrer    String? @db.VarChar(500)
  utmSource   String? @db.VarChar(500)
  utmMedium   String? @db.VarChar(500)
  utmCampaign String? @db.VarChar(500)
  utmContent  String? @db.VarChar(500)
  utmTerm     String? @db.VarChar(500)
  sessionId   String? @db.VarChar(191) // anonymous, rotated daily, no personal data
  ipHash      String? @db.VarChar(500) // sha256 hash, never the raw IP
  meta        String? @db.VarChar(500) // JSON string for event-specific data

  @@index([eventName, createdAt])
  @@index([createdAt])
}

// ─── Document Management ──────────────────────────────────────────
model Document {
  id           String @db.VarChar(191)   @id @default(cuid())
  title        String @db.VarChar(500)
  fileName     String @db.VarChar(500)
  fileUrl      String @db.VarChar(500)
  mimeType     String? @db.VarChar(500)
  size         Int?
  category     String? @db.VarChar(191) // contract | proposal | report | legal | financial | media | other
  description  String? @db.LongText
  uploadedById String? @db.VarChar(191)
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([createdAt])
}

// ─── Knowledge Base (for AI retrieval) ─────────────────────────────
model KnowledgeChunk {
  id         String @db.VarChar(191)   @id @default(cuid())
  documentId String @db.VarChar(191)
  content    String @db.LongText
  embedding  Json?
  chunkIndex Int
  status     String @db.VarChar(191)   @default("indexed") // indexed | pending | failed
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([documentId])
  @@index([chunkIndex])
  @@index([status])
}

// ─── Notifications ────────────────────────────────────────────────
model Notification {
  id        String @db.VarChar(191)   @id @default(cuid())
  userId    String? @db.VarChar(191)
  type      String @db.VarChar(191) // inquiry | meeting | ai-task | approval | system | contact | newsletter
  title     String @db.VarChar(500)
  message   String @db.VarChar(500)
  read      Boolean  @default(false)
  link      String? @db.VarChar(500)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

// ─── Site Settings / SEO ──────────────────────────────────────────
// Generic key-value store for site-level configuration (SEO meta,
// maintenance mode flag, robots.txt overrides, etc).
model Setting {
  id        String @db.VarChar(191)   @id @default(cuid())
  key       String @db.VarChar(500)   @unique
  value     String @db.VarChar(500)
  updatedAt DateTime @updatedAt
}

// ─── Media Library ────────────────────────────────────────────────
model MediaAsset {
  id        String @db.VarChar(191)   @id @default(cuid())
  filename  String @db.VarChar(500)
  url       String @db.VarChar(191)
  altText   String? @db.LongText
  mimeType  String? @db.VarChar(500)
  size      Int?
  width     Int?
  height    Int?
  category  String? @db.VarChar(191) // brand | portrait | project | article | case-study | general
  createdAt DateTime @default(now())

  @@index([category])
  @@index([createdAt])
}

// ══════════════════════════════════════════════════════════════════
// HIGHER STUDY PLATFORM — Universities, Courses, Scholarships, Research
// ══════════════════════════════════════════════════════════════════
// Added per Higher Study master prompt §42. All models prefixed with
// HigherStudy to avoid collisions with existing Project/Resource models.

// ─── Study Destinations ───────────────────────────────────────────
model HigherStudyCountry {
  id                     String @db.VarChar(191)                   @id @default(cuid())
  slug                   String @db.VarChar(191)                   @unique // uk, usa, canada, australia...
  name                   String @db.VarChar(500)
  officialName           String? @db.VarChar(500)
  region                 String? @db.VarChar(500) // Europe | North America | Asia-Pacific | Middle East
  overview               String? @db.VarChar(500)
  educationSystem        String? @db.VarChar(500)
  studyLevels            String? @db.VarChar(500) // comma-separated
  popularSubjects        String? @db.VarChar(500) // comma-separated
  tuitionFeeRange        String? @db.VarChar(500)
  livingCostRange        String? @db.VarChar(500)
  majorStudentCities     String? @db.VarChar(500) // comma-separated
  admissionRequirements  String? @db.VarChar(500)
  englishRequirements    String? @db.VarChar(500)
  availableIntakes       String? @db.VarChar(500)
  applicationDeadlines   String? @db.VarChar(500)
  scholarshipsAvailable  Boolean                  @default(true)
  researchOpportunities  Boolean                  @default(true)
  studentVisaOverview    String? @db.VarChar(500)
  financialEvidence      String? @db.VarChar(500)
  workRights             String? @db.VarChar(500)
  postStudyOpportunities String? @db.VarChar(500)
  accommodation          String? @db.VarChar(500)
  healthcare             String? @db.VarChar(500)
  transport              String? @db.VarChar(500)
  studentSafety          String? @db.VarChar(500)
  culturalInfo           String? @db.VarChar(500)
  applicationProcess     String? @db.VarChar(500)
  requiredDocuments      String? @db.VarChar(500)
  faq                    String? @db.VarChar(500) // JSON string
  officialSources        String? @db.VarChar(500) // JSON string
  imageUrl               String? @db.VarChar(500)
  flagEmoji              String? @db.VarChar(500)
  status                 String @db.VarChar(191)                   @default("published") // draft | pending-review | approved | published | needs-update | archived
  lastVerifiedAt         DateTime?
  lastVerifiedBy         String? @db.VarChar(500)
  officialSourceUrl      String? @db.VarChar(500)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  cities                 HigherStudyCity[]
  universities           HigherStudyUniversity[]
  courses                HigherStudyCourse[]
  scholarships           HigherStudyScholarship[]

  @@index([region])
  @@index([status])
}

model HigherStudyCity {
  id            String @db.VarChar(191)                  @id @default(cuid())
  slug          String @db.VarChar(191)                  @unique
  name          String @db.VarChar(500)
  countryId     String @db.VarChar(191)
  country       HigherStudyCountry      @relation(fields: [countryId], references: [id], onDelete: Cascade)
  overview      String? @db.VarChar(500)
  livingCost    String? @db.VarChar(500)
  transport     String? @db.VarChar(500)
  accommodation String? @db.VarChar(500)
  studentLife   String? @db.VarChar(500)
  status        String @db.VarChar(191)                  @default("published")
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  universities  HigherStudyUniversity[]

  @@index([countryId])
}

// ─── Universities ──────────────────────────────────────────────────
model HigherStudyUniversity {
  id                           String @db.VarChar(191)                       @id @default(cuid())
  slug                         String @db.VarChar(191)                       @unique
  officialName                 String @db.VarChar(500)
  alternativeNames             String? @db.VarChar(500) // comma-separated
