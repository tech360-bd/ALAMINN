// ══════════════════════════════════════════════════════════════════
// SOCIAL COMMAND CENTER — multi-account social automation (Phase B)
// Loose scalar FKs to User/Contact (no back-relations) to keep this
// migration additive and reversible. JSON payloads stored as String
// per existing schema convention (SQLite-compatible).
// ══════════════════════════════════════════════════════════════════

model SocialAccount {
  id               String @db.VarChar(191)    @id @default(cuid())
  platform         String @db.VarChar(191) // facebook | whatsapp | instagram | youtube | linkedin | tiktok
  externalId       String @db.VarChar(191) // page id / phone_number_id / ig user id
  displayName      String @db.VarChar(500)
  username         String? @db.VarChar(500)
  status           String @db.VarChar(191)    @default("disconnected") // connected | disconnected | expired | error | pending
  capabilities     String? @db.LongText // JSON string[] e.g. ["publish","inbox","comments"]
  tokenEncrypted   String? @db.VarChar(500) // AES-256-GCM ciphertext — never returned to client
  tokenExpiresAt   DateTime?
  webhookVerified  Boolean   @default(false)
  automationEnabled Boolean  @default(false)
  responseMode     String @db.VarChar(500)    @default("approval") // manual | approval | controlled
  aiProfileId      String? @db.VarChar(191)
  assignedUserId   String? @db.VarChar(191)
  lastHealthAt     DateTime?
  healthError      String? @db.VarChar(500)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  conversations    SocialConversation[]
  contents         SocialContentTarget[]

  @@unique([platform, externalId])
  @@index([platform])
  @@index([status])
}

model SocialAutomationState {
  id                 String @db.VarChar(191)   @id @default("global")
  engagementEnabled  Boolean  @default(false) // global auto-reply switch — default OFF (fail-safe)
  publishingEnabled  Boolean  @default(false)
  generationEnabled  Boolean  @default(true)
  version            Int      @default(1) // optimistic-concurrency / race guard
  changedById        String? @db.VarChar(191)
  changedByName      String? @db.VarChar(500)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AiPersonalityProfile {
  id                String @db.VarChar(191)   @id @default(cuid())
  name              String @db.VarChar(500)
  isDefault         Boolean  @default(false)
  identity          String? @db.VarChar(500) // preferred name + professional identity
  brandContext      String? @db.VarChar(500)
  languages         String @db.VarChar(500)   @default("en,bn") // comma list: en | bn | banglish
  formality         Int      @default(3) // 1 casual .. 5 formal
  friendliness      Int      @default(4) // 1 .. 5
  greeting          String? @db.VarChar(500)
  signOff           String? @db.VarChar(500)
  sentenceStyle     String? @db.VarChar(500) // short | balanced | detailed
  preferredPhrases  String? @db.VarChar(500) // JSON string[]
  avoidPhrases      String? @db.VarChar(500) // JSON string[]
  servicePrinciples String? @db.VarChar(500)
  faqs              String? @db.VarChar(500) // JSON [{q,a}]
  businessHours     String? @db.VarChar(500)
  escalationContact String? @db.VarChar(500)
  platformStyles    String? @db.VarChar(500) // JSON {facebook: "...", whatsapp: "..."}
  neverAnswerTopics String? @db.VarChar(500) // JSON string[] — always escalate
  examplePairs      String? @db.VarChar(500) // JSON [{incoming, approvedReply}]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isDefault])
}

model SocialKnowledgeSource {
  id        String @db.VarChar(191)   @id @default(cuid())
  title     String @db.VarChar(500)
  category  String @db.VarChar(191)   @default("faq") // faq | policy | service | pricing | document
  content   String @db.LongText
  approved  Boolean  @default(false)
  profileId String? @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([approved])
}

model SocialConversation {
  id               String @db.VarChar(191)          @id @default(cuid())
  accountId        String @db.VarChar(191)
  account          SocialAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform         String @db.VarChar(191)
  externalThreadId String @db.VarChar(191) // participant id / thread id from provider
  participantId    String @db.VarChar(191)
  participantName  String? @db.VarChar(500)
  status           String @db.VarChar(191)          @default("unread") // unread | pending | resolved | escalated
  priority         String @db.VarChar(191)          @default("normal") // low | normal | high | urgent
  assignedUserId   String? @db.VarChar(191)
  labels           String? @db.LongText // JSON string[]
  language         String? @db.VarChar(191)
  contactId        String? @db.VarChar(191) // link to CRM Contact
  unreadCount      Int             @default(0)
  lastMessageAt    DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  messages         SocialMessage[]

  @@unique([accountId, externalThreadId])
  @@index([platform])
  @@index([status])
  @@index([lastMessageAt])
}

model SocialMessage {
  id                String @db.VarChar(191)             @id @default(cuid())
  conversationId    String @db.VarChar(191)
  conversation      SocialConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  providerMessageId String? @db.VarChar(191)
  direction         String @db.VarChar(191) // inbound | outbound
  kind              String @db.VarChar(191)   @default("message") // message | comment | mention
  senderId          String? @db.VarChar(191)
  senderName        String? @db.VarChar(500)
  body              String @db.LongText
  mediaUrl          String? @db.VarChar(500)
  isOwn             Boolean            @default(false)
  deliveryStatus    String @db.VarChar(191)   @default("received") // received | queued | sending | sent | delivered | read | failed | suppressed
  createdAt         DateTime           @default(now())

  @@unique([providerMessageId])
  @@index([conversationId, createdAt])
  @@index([deliveryStatus])
}

model SocialWebhookEvent {
  id              String @db.VarChar(191)    @id @default(cuid())
  provider        String @db.VarChar(191)
  providerEventId String @db.VarChar(191)
  accountId       String? @db.VarChar(191)
  payloadHash     String @db.VarChar(500)
  status          String @db.VarChar(191)    @default("received") // received | processed | duplicate | failed | ignored
  attempts        Int       @default(0)
  error           String? @db.LongText
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([provider, providerEventId])
  @@index([status])
  @@index([createdAt])
}

model SocialReplyDecision {
  id             String @db.VarChar(191)   @id @default(cuid())
  conversationId String @db.VarChar(191)
  messageId      String? @db.VarChar(191)
  category       String @db.VarChar(191) // general | service | lead | appointment | complaint | spam | sensitive | pricing | human-required
  language       String? @db.VarChar(191)
  confidence     Float    @default(0)
  risk           String @db.VarChar(191)   @default("high") // low | medium | high
  draft          String? @db.LongText
  finalText      String? @db.LongText
  decision       String @db.VarChar(191)   @default("held") // auto_sent | held | approved_sent | edited_sent | rejected | escalated | suppressed_off | manual_sent | failed
  reason         String? @db.VarChar(500)
  modelUsed      String? @db.VarChar(500)
  knowledgeRefs  String? @db.LongText // JSON string[]
  automationVersion Int?  // global switch version observed at decision time
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([conversationId])
  @@index([decision])
  @@index([createdAt])
}

model SocialApproval {
  id          String @db.VarChar(191)   @id @default(cuid())
  decisionId  String @db.VarChar(191)   @unique
  status      String @db.VarChar(191)   @default("pending") // pending | approved | edited_approved | rejected | escalated | resolved
  editedText  String? @db.LongText
  decidedById String? @db.VarChar(191)
  decidedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model SocialAutomationRule {
  id              String @db.VarChar(191)   @id @default(cuid())
  name            String @db.VarChar(500)
  accountId       String? @db.VarChar(191) // null = all accounts
  platform        String? @db.VarChar(191)
  category        String? @db.VarChar(191) // null = any category
  action          String @db.VarChar(191)   @default("approval") // auto_reply | approval | escalate | ignore
  minConfidence   Float    @default(0.85)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId])
  @@index([enabled])
}

model SocialCampaign {
  id          String @db.VarChar(191)   @id @default(cuid())
  name        String @db.VarChar(500)
  objective   String? @db.VarChar(500)
  pillar      String? @db.VarChar(500)
  audience    String? @db.VarChar(500)
  status      String @db.VarChar(191)   @default("draft") // draft | active | paused | completed
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  contents    SocialContent[]
  emailCampaigns EmailCampaign[]
  budget      Int      @default(0)
  currency    String @db.VarChar(191)   @default("USD")
  channels    String @db.LongText   @default("[]")
  brief       String? @db.VarChar(500)
  utmCampaign String? @db.VarChar(500)

  @@index([status])
}

model SocialContent {
  id          String @db.VarChar(191)   @id @default(cuid())
  campaignId  String? @db.VarChar(191)
  campaign    SocialCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  title       String @db.VarChar(500)
  body        String @db.LongText
  variants    String? @db.LongText // JSON {platform: body}
  hashtags    String? @db.LongText // JSON string[]
  cta         String? @db.VarChar(500)
  mediaUrls   String? @db.LongText // JSON string[]
  language    String @db.VarChar(191)   @default("en")
  status      String @db.VarChar(191)   @default("draft") // draft | review | approved | scheduled | publishing | published | failed
  scheduledAt DateTime?
  approvedById String? @db.VarChar(191)
  createdById String? @db.VarChar(191)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  targets     SocialContentTarget[]

  @@index([status])
  @@index([scheduledAt])
}

model SocialContentTarget {
  id          String @db.VarChar(191)        @id @default(cuid())
  contentId   String @db.VarChar(191)
  content     SocialContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  accountId   String @db.VarChar(191)
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status      String @db.VarChar(191)        @default("pending") // pending | publishing | published | failed | suppressed
  providerPostId String? @db.VarChar(191)
  error       String? @db.LongText
  attempts    Int           @default(0)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([contentId, accountId])
  @@index([status])
}

// ══════════════════════════════════════════════════════════════════
// HIGHER STUDY — Source registry, 7-day monitoring, change approval
// (additive; production catalogue rows are NEVER mutated by the agent
//  — only via Super Admin approval in the verification queue)
// ══════════════════════════════════════════════════════════════════

model HigherStudyFaculty {
  id           String @db.VarChar(191)   @id @default(cuid())
  universityId String @db.VarChar(191)
  name         String @db.VarChar(500)
  type         String @db.VarChar(191)   @default("faculty") // faculty | school | department | college | institute
  parentId     String? @db.VarChar(191)
  officialUrl  String? @db.VarChar(500)
  sourceUrl    String? @db.VarChar(500)
  lastVerifiedAt DateTime?
  verificationStatus String @db.VarChar(191) @default("pending-review")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([universityId])
  @@index([type])
}

model HigherStudyCourseIntake {
  id             String @db.VarChar(191)   @id @default(cuid())
  courseId       String @db.VarChar(191)
  intakeName     String @db.VarChar(500) // e.g. September 2027
  academicYear   String? @db.VarChar(500)
  opensAt        DateTime?
  deadline       DateTime?
  intlDeadline   DateTime?
  scholarshipDeadline DateTime?
  startsAt       DateTime?
  rolling        Boolean  @default(false)
  intlConfirmed  Boolean  @default(false)
  sourceUrl      String? @db.VarChar(500)
  lastVerifiedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([courseId])
  @@index([deadline])
  @@index([startsAt])
}

model HigherStudySourceRecord {
  id           String @db.VarChar(191)   @id @default(cuid())
  url          String @db.VarChar(191)   @unique
  owner        String? @db.VarChar(500) // university / government body
  sourceType   String @db.VarChar(191)   @default("university-course") // university-course | uni-admissions | uni-fees | uni-scholarship | government | immigration | ranking | pdf
  entityType   String? @db.VarChar(191) // university | course | scholarship | country | government
  entityId     String? @db.VarChar(191)
  countrySlug  String? @db.VarChar(500)
  title        String? @db.VarChar(500)
  licenseNote  String? @db.VarChar(500)
  active       Boolean  @default(true)
  lastCheckedAt DateTime?
  lastStatus   String? @db.VarChar(191) // ok | unavailable | parse-error | changed
  failCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([entityType, entityId])
  @@index([active])
  @@index([sourceType])
}

model HigherStudySourceSnapshot {
  id          String @db.VarChar(191)   @id @default(cuid())
  sourceId    String @db.VarChar(191)
  contentHash String @db.VarChar(191)
  title       String? @db.VarChar(500)
  signals     String? @db.LongText // JSON extracted signals {fees:[], deadlines:[], ielts:null,...}
  fetchedAt   DateTime @default(now())
  httpStatus  Int?
  @@index([sourceId, fetchedAt])
  @@index([contentHash])
}

model HigherStudyDataChange {
  id             String @db.VarChar(191)   @id @default(cuid())
  runId          String? @db.VarChar(191)
  sourceId       String? @db.VarChar(191)
  entityType     String @db.VarChar(191) // university | course | scholarship | government
  entityId       String? @db.VarChar(191)
  entityLabel    String? @db.VarChar(500)
  field          String? @db.VarChar(191)
  changeType     String @db.VarChar(191) // NEW_COURSE | COURSE_CLOSED | FEE_CHANGED | DEADLINE_CHANGED | REQUIREMENT_CHANGED | ENGLISH_REQUIREMENT_CHANGED | SCHOLARSHIP_NEW | SCHOLARSHIP_UPDATED | INTAKE_CHANGED | SOURCE_CHANGED | SOURCE_UNAVAILABLE | POSSIBLE_DATA_CONFLICT | NEEDS_MANUAL_REVIEW | OFFICIAL_POLICY_CHANGE | GOVERNMENT_POLICY_CHANGE ...
  impact         String @db.VarChar(191)   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  oldValue       String? @db.LongText
  newValue       String? @db.LongText
  sourceUrl      String? @db.VarChar(500)
  confidence     Float    @default(0)
  aiSummary      String? @db.LongText
  status         String @db.VarChar(191)   @default("pending") // pending | approved | rejected | needs-review | recheck-requested
  decidedById    String? @db.VarChar(191)
  decidedAt      DateTime?
  detectedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([status])
  @@index([changeType])
  @@index([entityType, entityId])
  @@index([detectedAt])
}

model HigherStudyMonitoringRun {
  id           String @db.VarChar(191)   @id @default(cuid()) // also the dedup/lock key per cycle
  status       String @db.VarChar(191)   @default("running") // running | completed | failed
  sourcesChecked Int    @default(0)
  sourcesFailed  Int    @default(0)
  changesDetected Int   @default(0)
  error        String? @db.LongText
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  nextRunAt    DateTime?
  @@index([status])
  @@index([startedAt])
}

model HigherStudyOfficialDocument {
  id           String @db.VarChar(191)   @id @default(cuid())
  title        String @db.VarChar(500)
  sourceUrl    String @db.VarChar(500)
  universityId String? @db.VarChar(191)
  countrySlug  String? @db.VarChar(500)
  category     String @db.VarChar(191)   @default("guide") // admission-guide | scholarship-pdf | handbook | policy
  fileHash     String? @db.VarChar(191)
  version      Int      @default(1)
  approvalStatus String @db.VarChar(191) @default("pending") // pending | approved | rejected
  publishedAt  DateTime?
  discoveredAt DateTime @default(now())
  lastCheckedAt DateTime?
  @@unique([sourceUrl, version])
  @@index([countrySlug])
  @@index([approvalStatus])
}

// ─── Integrated feature kits (additive, no existing data rewritten) ─────
model KitDocument {
  id          String @db.VarChar(191)   @id @default(cuid())
  kind        String @db.VarChar(191) // diagram | humanizer | storyboard | email-template
  title       String @db.VarChar(500)
  content     String @db.LongText // validated JSON or plain text, depending on kind
  metadata    String? @db.LongText // provider / model / tone; never credentials
  createdById String? @db.VarChar(191)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind, updatedAt])
  @@index([createdById])
}

model SeoAudit {
  id          String @db.VarChar(191)   @id @default(cuid())
  url         String @db.VarChar(191)
  score       Int
  checks      String @db.LongText // JSON SeoCheck[]
  summary     String @db.LongText
  createdById String? @db.VarChar(191)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model EmailCampaign {
  id           String @db.VarChar(191)         @id @default(cuid())
  name         String @db.VarChar(500)
  subject      String @db.VarChar(500)
  preheader    String? @db.VarChar(500)
  bodyHtml     String @db.LongText
  bodyText     String @db.LongText
  content      String @db.LongText // validated EmailContent JSON for safe personalized rendering
  audience     String @db.VarChar(500)         @default("all")
  status       String @db.VarChar(191)         @default("draft") // draft | queued | sending | sent | failed
  scheduledAt  DateTime?
  sentAt       DateTime?
  createdById  String? @db.VarChar(191)
  campaignId   String? @db.VarChar(191)
  campaign     SocialCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  deliveries   EmailDelivery[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, scheduledAt])
}

model EmailDelivery {
  id           String @db.VarChar(191)        @id @default(cuid())
  campaignId   String @db.VarChar(191)
  campaign     EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriberId String @db.VarChar(191)
  email        String @db.VarChar(191)
  status       String @db.VarChar(191)        @default("pending") // pending | sending | sent | failed | skipped
  providerId   String? @db.VarChar(191)
  error        String? @db.LongText
  attempts     Int           @default(0)
  sentAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([campaignId, subscriberId])
  @@index([status, updatedAt])
}

model SupportConversation {
  id            String @db.VarChar(191)           @id @default(cuid())
  visitorName   String @db.VarChar(500)
  visitorEmail  String? @db.VarChar(500)
  tokenHash     String @db.VarChar(191)           @unique
  status        String @db.VarChar(191)           @default("open") // open | pending | resolved
  assignedTo    String? @db.VarChar(500)
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  messages      SupportMessage[]

  @@index([status, lastMessageAt])
}

model SupportMessage {
  id             String @db.VarChar(191)              @id @default(cuid())
  conversationId String @db.VarChar(191)
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String @db.VarChar(191) // visitor | agent | system
  senderName     String @db.VarChar(500)
  body           String @db.LongText
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}

// Experimental AgentOS foundation; not wired into existing AI tasks.
model AgentOsTask {
  id String @db.VarChar(191) @id
  project String @db.VarChar(191)
  agent String @db.VarChar(191)
  objective String @db.LongText
  inputs String @db.LongText
  permissions String @db.LongText
  outputs String? @db.LongText
  deadline DateTime
  maxAttempts Int
  attempts Int @default(0)
  status String @db.VarChar(191) @default("queued")
  leaseToken String? @db.VarChar(191)
  leaseUntil DateTime?
  createdBy String @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, leaseUntil])
}

model AgentOsApproval {
  id String @db.VarChar(191) @id
  taskId String @db.VarChar(191)
  action String @db.VarChar(191)
  decision String @db.VarChar(191)
  decidedBy String? @db.VarChar(191)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([taskId])
}

model AgentOsAudit {
  sequence Int @id
  event String @db.LongText
  previousHash String @db.VarChar(191)
  hash String @db.VarChar(191)
  createdAt DateTime @default(now())
}

// ════════════════════════════════════════════════════════════════════
// ALO Education UCI + Universal Messaging Channel + Staff auth models
// (parity with schema.prisma — MessagingUser was `User` in the standalone
//  UCI build, renamed to avoid collision with the CRM `User` above)
// ════════════════════════════════════════════════════════════════════

model Tenant {
  id             String   @id @default(cuid())
  slug           String   @unique // stable machine identifier used in URLs/rooms
  name           String // provisioned per deployment; never hard-coded
  timezone       String   @default("Asia/Dhaka")
  messagingStart Int      @default(9) // allowed messaging window, tenant-local hours
  messagingEnd   Int      @default(21)
  languages      String   @default("bn,en,banglish")
  aiAutoReply    Boolean  @default(true)
  createdAt      DateTime @default(now())

  users          MessagingUser[]
  conversations  Conversation[]
  consents       Consent[]
  suppressions   SuppressEntry[]
  moderationWord ModerationWord[]
  reports        Report[]
  auditEvents    AuditEvent[]
  handoffs       HandoffEvent[]
  tags           Tag[]
}

model MessagingUser {
  id                 String    @id @default(cuid())
  tenantId           String
  externalRef        String? // CRM/identity reference; uniqueness enforced per tenant only
  displayName        String
  role               String    @default("customer") // admin | agent | customer | ai
  locale             String    @default("bn")
  lastSeenAt         DateTime?
  isBanned           Boolean   @default(false)
  isVerifiedBusiness Boolean   @default(false)
  blockedIds         String    @default("[]") // JSON array of blocked user ids
  createdAt          DateTime  @default(now())

  tenant          Tenant                 @relation(fields: [tenantId], references: [id])
  participations  ConversationParticipant[]
  messages        Message[]
  receipts        Receipt[]
  stars           Star[]
  reportsFiled    Report[]               @relation("Reporter")
  claimedHandoffs HandoffEvent[]

  @@unique([tenantId, externalRef])
  @@index([tenantId])
}

// ─────────────────────────── Conversations ───────────────────────────

model Conversation {
  id           String    @id @default(cuid())
  tenantId     String
  type         String // direct | group | channel | self
  title        String?
  mode         String    @default("two_way") // one_way | two_way (channels)
  visibility   String    @default("private") // private | public
  aiMode       Boolean   @default(true)
  status       String    @default("active") // active | needs_human | closed
  burnoutAfter DateTime? // whole-conversation auto-delete instant
  createdAt    DateTime  @default(now())

  tenant       Tenant                   @relation(fields: [tenantId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]
  handoffs     HandoffEvent[]
  tags         Tag[]

  @@index([tenantId])
}

model ConversationParticipant {
  id               String    @id @default(cuid())
  conversationId   String
  userId           String
  role             String    @default("member") // owner | admin | member
  lastReadMessageId String?
  joinedAt         DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         MessagingUser @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
}

// ───────────────────────────── Messages ─────────────────────────────

model Message {
  id             String    @id @default(cuid())
  tenantId       String
  conversationId String
  senderId       String?
  type           String    @default("text") // text | poll | admin | structured | custom | system | attachment
  body           String    @default("")
  payload        String? // JSON payload (poll options/votes, structured blocks, attachment meta)
  mentions       String    @default("[]") // JSON array of mentioned user ids
  language       String?
  translation    String? // cached translation (JSON: {lang, text})
  scheduledFor   DateTime?
  sentAt         DateTime?
  expiresAt      DateTime? // disappearing-message expiry
  hidden         Boolean   @default(false) // moderation flag
  createdAt      DateTime  @default(now())

  conversation Conversation              @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       MessagingUser?                     @relation(fields: [senderId], references: [id])
  receipts     Receipt[]
  stars        Star[]

  @@index([conversationId, createdAt])
  @@index([tenantId])
}

// per-recipient delivery/read receipts
model Receipt {
  id          String    @id @default(cuid())
  tenantId    String
  messageId   String
  userId      String
  deliveredAt DateTime?
  readAt      DateTime?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user         MessagingUser @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
  @@index([userId])
}

model Star {
  id        String   @id @default(cuid())
  tenantId  String
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user         MessagingUser @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
}

model Tag {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String
  label          String
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, label])
}

// ─────────────────────── Compliance control plane ───────────────────────
// Stays inside the program; no third party ever owns consent state.

model Consent {
  id         String    @id @default(cuid())
  tenantId   String
  subjectRef String // external identity of the messaging/calling subject
  channel    String // chat | voice | sms
  purpose    String
  grantedAt  DateTime?
  revokedAt  DateTime?
  proofRef   String? // record of how consent was captured

  tenant Tenant  @relation(fields: [tenantId], references: [id])

  @@index([tenantId, subjectRef])
}

model SuppressEntry {
  id        String   @id @default(cuid())
  tenantId  String
  channel   String // chat | voice | sms | all
  value     String // phone / externalRef / email
  reason    String?
  addedAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, channel, value])
}

model ModerationWord {
  id       String @id @default(cuid())
  tenantId String
  word     String
  severity String @default("block") // block | flag

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, word])
}

model Report {
  id           String   @id @default(cuid())
  tenantId     String
  reporterId   String
  targetUserId String?
  messageId    String?
  reason       String
  status       String   @default("open") // open | reviewed | dismissed
  createdAt    DateTime @default(now())

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  reporter     MessagingUser @relation("Reporter", fields: [reporterId], references: [id])

  @@index([tenantId, status])
}

model AuditEvent {
  id          String   @id @default(cuid())
  tenantId    String
  type        String // e.g. consent.granted, message.blocked, hours.violation
  actorId     String?
  subjectType String?
  subjectId   String?
  detail      String?
  at          DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, at])
}

model HandoffEvent {
  id             String    @id @default(cuid())
  tenantId       String
  conversationId String
  trigger        String // customer_request | low_confidence | negative_sentiment | repeated_failure | vip | compliance | manual
  detail         String?
  status         String    @default("open") // open | claimed | resolved
  claimedById    String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  claimedBy    MessagingUser?        @relation(fields: [claimedById], references: [id])

  @@index([tenantId, status])
}

// ═══════════════════════════════════════════════════════════════════════════
// ALO EDUCATION — UNIVERSITY & COURSE INTELLIGENCE SYSTEM (UCI)
// Additive module: collects, verifies, structures and monitors publicly
// available university/course information with full source provenance.
// Verification statuses follow the module specification §4. No value is
// invented: unknown stays unknown.
// ═══════════════════════════════════════════════════════════════════════════

model UciSource {
  id              String   @id @default(cuid())
  key             String   @unique // stable machine key, e.g. "official_lsbu", "platform_applyboard", "marge"
  name            String
  url             String?  // exact source URL when confirmed
  level           String // OFFICIAL | PLATFORM | PUBLIC | INTERNAL
  identityStatus  String   @default("CONFIRMED") // CONFIRMED | PENDING_IDENTITY | UNREACHABLE
  permissionNotes String?  // permitted collection basis, robots/terms observations
  robotsAllowed   Boolean? // null = not yet checked
  lastCheckedAt   DateTime?
  notes           String?
  createdAt       DateTime @default(now())

  jobs UciCollectionJob[]
}

model UciInstitution {
  id              String   @id @default(cuid())
  canonicalName   String   @unique
  asWritten       String   @default("[]") // JSON array of name variants found in sources
  country         String
  cityNotes       String   @default("[]") // JSON array of city/campus strings as published
  institutionType String   @default("UNKNOWN") // UNIVERSITY | COLLEGE | INSTITUTE | PATHWAY_PROVIDER | OTHER | UNKNOWN
  priorityCohort  Boolean  @default(false) // member of the 27 priority UK universities
  officialWebsite String?
  status          String   @default("DISCOVERED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  records    UciRequirementRecord[]
  programmes UciProgramme[]
}

model UciRequirementRecord {
  id                String    @id @default(cuid())
  institutionId     String
  context           String? // e.g. "UK Bangladesh 2026", "UK MOI policy 2027"
  fieldsJson        String // verbatim captured fields (raw), JSON object
  sourceFile        String // internal evidence file key
  sheet             String
  rowNumber         Int
  sourceUrl         String? // official URL when captured with the record
  academicYear      String?
  verificationStatus String  @default("SOURCE_CHECK_REQUIRED")
  collectedAt       DateTime  @default(now())
  lastCheckedAt     DateTime?
  lastVerifiedAt    DateTime?
  reviewedBy        String?
  retiredReason     String?

  institution UciInstitution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  events      UciVerificationEvent[]

  @@index([institutionId, verificationStatus])
  @@index([verificationStatus])
}

model UciProgramme {
  id                String   @id @default(cuid())
  institutionId     String?
  institutionName   String // as-written fallback when no institution row exists yet
  country           String
  level             String?
  programName       String
  duration          String?
  tuition           String?
  extraJson         String   @default("{}")
  sourceFile        String
  sheet             String
  rowNumber         Int
  sourceUrl         String?
  verificationStatus String  @default("SOURCE_CHECK_REQUIRED")
  collectedAt       DateTime @default(now())
  lastCheckedAt     DateTime?
  lastVerifiedAt    DateTime?
  reviewedBy        String?

  institution UciInstitution? @relation(fields: [institutionId], references: [id])

  @@index([institutionName])
  @@index([level])
  @@index([country])
}

model UciVerificationEvent {
  id          String   @id @default(cuid())
  recordId    String
  action      String // VERIFY | CORRECT | RETIRE | APPROVE | FLAG_CONFLICT | RESOLVE_CONFLICT | NOTE
  fromStatus  String?
  toStatus    String?
  actor       String   @default("admin")
  note        String?
  fieldPatch  String? // JSON object of corrected field values (never overwrites raw silently)
  createdAt   DateTime @default(now())

  record UciRequirementRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
}

model UciCollectionJob {
  id          String    @id @default(cuid())
  sourceKey   String
  targetUrl   String
  type        String    @default("SOURCE_CHECK") // SOURCE_CHECK | DISCOVERY
  status      String    @default("PENDING") // PENDING | RUNNING | SUCCESS | FAILED | ROBOTS_BLOCKED
  httpStatus  Int?
  contentHash String? // sha256 of response body for change detection
  bytes       Int?
  findings    String?
  lastError   String?
  attempts    Int       @default(0)
  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  source UciSource @relation(fields: [sourceKey], references: [key])

  @@index([status])
}

model UciAuditLog {
  id         String   @id @default(cuid())
  actor      String   @default("admin")
  action     String
  entity     String
  entityId   String
  detail     String? // JSON detail
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
}

// ═══════════════════════════════════════════════════════════════════════════
// STAFF AUTHENTICATION & RBAC
// Application-level accounts for the dashboards (admin / editor / agent /
// viewer). Passwords are stored as scrypt(salt:hash); sessions are revocable
// DB rows referenced by an HMAC-signed cookie token. Roles are enforced in
// middleware (edge) and re-verified server-side on every API route.
// ═══════════════════════════════════════════════════════════════════════════

model StaffAccount {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String // scrypt format: salt:hash (hex)
  name         String
  role         String    @default("VIEWER") // ADMIN | EDITOR | AGENT | VIEWER
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions   StaffSession[]
  resetCodes PasswordResetCode[]
}

model StaffSession {
  id        String    @id @default(cuid())
  accountId String
  tokenHash String    @unique // sha256(hex) of the cookie token
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  account StaffAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model PasswordResetCode {
  id        String    @id @default(cuid())
  accountId String
  codeHash  String    // sha256 of the 6-digit OTP
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  account StaffAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}
