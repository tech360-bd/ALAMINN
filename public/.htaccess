# Block dotfiles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block .env files
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# Block backup files
<FilesMatch "\.(bak|backup|old|orig|tmp|swp|save|~)$">
    Require all denied
</FilesMatch>

# Block SQL dumps
<FilesMatch "\.(sql|sql\.gz|db|db-journal|sqlite)$">
    Require all denied
</FilesMatch>

# Block archive files (source code shouldn't be in public)
<FilesMatch "\.(zip|tar|tar\.gz|tgz|tar\.bz2|rar|7z|gz)$">
    Require all denied
</FilesMatch>

# Block log files
<FilesMatch "\.(log|log\.\d+)$">
    Require all denied
</FilesMatch>

# Block source maps in production
<FilesMatch "\.map$">
    Require all denied
</FilesMatch>

# Block TypeScript/JSX source
<FilesMatch "\.(tsx?|jsx?)$">
    Require all denied
</FilesMatch>
# Exception: allow .js files in _next/static/ (compiled bundles)
<FilesMatch "^_next/static/.*\.js$">
    Require all granted
</FilesMatch>

# Disable directory listing
Options -Indexes

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # HSTS (only add if HTTPS is active — cPanel usually handles this)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>

# Compress responses
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/json "access plus 1 hour"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
