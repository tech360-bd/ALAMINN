[Unit]
Description=Alaminn.info — Universal Messaging Channel mini-service (:3010)
Documentation=https://alaminn.info
After=network.target mariadb.service mysql.service alaminn-info.service
Wants=network.target

[Service]
Type=simple
User=aloedu
Group=aloedu

WorkingDirectory=/var/www/alaminn-info

EnvironmentFile=/var/www/alaminn-info/.env

Environment=NODE_ENV=production
Environment=BUN_JSC_maxOldSpaceSize=256

ExecStart=/home/aloedu/.bun/bin/bun run /var/www/alaminn-info/mini-services/messaging-channel/index.ts

Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=5

MemoryMax=384M
CPUQuota=100%

StandardOutput=journal
StandardError=journal
SyslogIdentifier=alaminn-umc

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
ReadWritePaths=/var/www/alaminn-info

[Install]
WantedBy=multi-user.target
