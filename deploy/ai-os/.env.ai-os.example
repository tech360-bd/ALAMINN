# ALAMINN AI-OS environment — copy to .env.ai-os and fill every value.
# Generate secrets with:  openssl rand -hex 32
# NEVER commit the filled .env.ai-os file.

# ── Public base URL of the ALAMINN nginx reverse proxy (AI-OS vhost) ──────
# Example: https://ai-os.alaminn.info
AI_OS_PUBLIC_URL=https://ai-os.example.com

# ── LiteLLM (unified LLM proxy) ───────────────────────────────────────────
# The master key the ALAMINN ecosystem copilot uses (sk-...). Keep secret.
LITELLM_MASTER_KEY=sk-changeme
# Optional Postgres for LiteLLM virtual keys/spend tracking.
LITELLM_DATABASE_URL=

# ── LibreChat ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 16  (creds key/iv must be 32 hex chars)
LIBRECHAT_CREDS_KEY=changeme
LIBRECHAT_CREDS_IV=changeme
LIBRECHAT_JWT_SECRET=changeme

# ── Activepieces ──────────────────────────────────────────────────────────
ACTIVEPIECES_ENCRYPTION_KEY=changeme
ACTIVEPIECES_JWT_SECRET=changeme

# ── Shared Postgres (Activepieces + NocoBase) ────────────────────────────
POSTGRES_USER=aios
POSTGRES_PASSWORD=changeme

# ── Temporal ──────────────────────────────────────────────────────────────
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=changeme

# ── Directus ─────────────────────────────────────────────────────────────
DIRECTUS_SECRET=changeme
DIRECTUS_ADMIN_EMAIL=admin@alaminn.info
DIRECTUS_ADMIN_PASSWORD=changeme

# ── NocoBase ──────────────────────────────────────────────────────────────
NOCOBASE_APP_KEYS=changeme
NOCOBASE_SECRET_KEY=changeme

# ── ALAMINN side (set on the Next.js app environment, not here) ──────────
# ALAMINN_ECOSYSTEM_API_KEY: the bootstrap key the AI-OS services use to
#   call https://alaminn.info/api/v1/ecosystem/* (leads, applications,
#   copilot). Minimum 32 characters, e.g. openssl rand -hex 32.
# Then register each service's base URL in /admin/integrations:
#   - litellm:   https://<AI_OS_PUBLIC_URL>/litellm  + master key
#   - librechat: https://<AI_OS_PUBLIC_URL>/librechat
#   - open-webui, activepieces, temporal (host:port), directus, nocobase
