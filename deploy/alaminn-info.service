[Unit]
Description=Alaminn.info — Next.js 16 production app (Bun + Nginx)
Documentation=https://alaminn.info
After=network.target mariadb.service mysql.service
Wants=network.target

[Service]
Type=simple
User=aloedu
Group=aloedu

WorkingDirectory=/var/www/alaminn-info

EnvironmentFile=/var/www/alaminn-info/.env

Environment=NODE_ENV=production
Environment=PORT=3056
Environment=BUN_JSC_maxOldSpaceSize=512

ExecStart=/home/aloedu/.bun/bin/bun run /var/www/alaminn-info/.next/standalone/server.js

Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=5

MemoryMax=768M
CPUQuota=150%

StandardOutput=journal
StandardError=journal
SyslogIdentifier=alaminn-info

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
ReadWritePaths=/var/www/alaminn-info

[Install]
WantedBy=multi-user.target
