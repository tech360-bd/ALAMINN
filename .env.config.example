# ════════════════════════════════════════════════════════════════════════
#  Al Aminn Info — environment template
#  Copy to `.env.config` and fill in real values. NEVER commit .env.config.
#
#  Why `.env.config` and not `.env`?  (Rule 5 / Rule 9.2)
#  Next.js expands `$` inside `.env` / `.env.local`, which silently corrupts
#  passwords and secrets such as `p$a$s`. This project loads `.env.config`
#  itself, with no expansion, via src/lib/load-env.ts.
# ════════════════════════════════════════════════════════════════════════

# ─── Core ───────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT=3056
NEXT_PUBLIC_SITE_URL="https://alaminn.info"
NEXTAUTH_URL="https://alaminn.info"

# SQLite file (relative to the project root). Gitignored.
DATABASE_URL="file:./db/custom.db"

# ─── Auth (Rule 1) ──────────────────────────────────────────────────────
# 32+ bytes. Generate: openssl rand -hex 32
JWT_SECRET="replace-with-64-char-random-string"
# Legacy alias — the code prefers JWT_SECRET. Keep only for old deployments.
# AUTH_SECRET=""

# Staff dashboards (/dashboard, /console) use their own signed session.
SESSION_SECRET="replace-with-another-64-char-random-string"

# ─── Cron ───────────────────────────────────────────────────────────────
# Sent as the `x-cron-secret` header by system cron / PM2 cron jobs.
CRON_SECRET="replace-with-random-cron-secret"

# ─── Local AI (Ollama, CPU-only — allow up to 120s) ─────────────────────
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:8b"

# ─── Email (Nodemailer / SMTP) ──────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="email@gmail.com"
SMTP_PASS="app-password"
SMTP_FROM="Al Aminn <noreply@alaminn.info>"
# The app also reads EMAIL_FROM; keep both in sync.
EMAIL_FROM="Al Aminn <noreply@alaminn.info>"
EMAIL_REPLY_TO="noreply@alaminn.info"

# Optional: Resend instead of SMTP
# RESEND_API_KEY=""

# ─── Seed / bootstrap (used by `npm run db:seed` only) ─────────────────
ADMIN_BOOTSTRAP_EMAIL="admin@alaminn.info"
# Generate: openssl rand -base64 18   (min 12 chars recommended)
ADMIN_BOOTSTRAP_PASSWORD="change-me-before-seeding"

# ─── LinkedIn recommendations ──────────────────────────────────────────
# Optional fallback for the public LinkedIn profile URL. The value saved in
# /admin/endorsements (Setting `social.linkedin_url`) takes precedence.
NEXT_PUBLIC_LINKEDIN_URL=""

# ─── Optional integrations ─────────────────────────────────────────────
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# WHATSAPP_API_PHONE_NUMBER_ID=""
# WHATSAPP_API_TOKEN=""

# ─── SMS (free provider failover loop) ─────────────────────────────────
# Preferred provider: "httpsms" | "textbelt" | "twilio" | "plivo" | "auto"
# SMS_PREFERRED_PROVIDER="httpsms"

# httpSMS (self-hosted via your Android phone) — https://github.com/NdoleStudio/httpsms
# SMS_HTTPSMS_API_KEY=""
# SMS_HTTPSMS_BASE_URL="https://api.httpsms.com"
# SMS_HTTPSMS_FROM="+18005550199"

# Textbelt (free tier: key "TEXTBELT" = 1 SMS/day per phone number)
# SMS_TEXTBELT_KEY="TEXTBELT"

# Twilio (free trial) / Plivo (free trial)
# SMS_TWILIO_ACCOUNT_SID=""
# SMS_TWILIO_AUTH_TOKEN=""
# SMS_TWILIO_FROM="+15017122661"
# SMS_PLIVO_AUTH_ID=""
# SMS_PLIVO_AUTH_TOKEN=""
# SMS_PLIVO_FROM="+14155550000"

# ─── Email (free provider failover loop, from jixserver/free-for-dev → Email) ─
# Preferred provider: "sparkpost" | "mailgun" | "sendgrid" | "mailjet" |
#   "sendinblue" | "sendpulse" | "pepipost" | "elasticemail" | "resend" | "smtp" | "auto"
# EMAIL_PREFERRED_PROVIDER="sparkpost"

# SparkPost — 100,000 emails/month free
# EMAIL_SPARKPOST_API_KEY=""
# EMAIL_SPARKPOST_FROM="hello@example.com"

# Mailgun — 10,000 emails/month free
# EMAIL_MAILGUN_API_KEY=""
# EMAIL_MAILGUN_DOMAIN="sandbox.mailgun.org"
# EMAIL_MAILGUN_FROM="hello@example.com"

# SendGrid — 12,000 emails/month free
# EMAIL_SENDGRID_API_KEY=""
# EMAIL_SENDGRID_FROM="hello@example.com"

# Mailjet — 6,000 emails/month free
# EMAIL_MAILJET_API_KEY=""
# EMAIL_MAILJET_SECRET_KEY=""
# EMAIL_MAILJET_FROM="hello@example.com"

# SendinBlue (Brevo) — 9,000 emails/month free
# EMAIL_SENDINBLUE_API_KEY=""
# EMAIL_SENDINBLUE_FROM="hello@example.com"

# SendPulse — 50 emails/hour, 12,000/month free
# EMAIL_SENDPULSE_CLIENT_ID=""
# EMAIL_SENDPULSE_CLIENT_SECRET=""
# EMAIL_SENDPULSE_FROM="hello@example.com"

# Pepipost — unlimited first 3 months, then 25,000/month free
# EMAIL_PEPIPOST_API_KEY=""
# EMAIL_PEPIPOST_FROM="hello@example.com"

# Elastic Email — 150,000 emails/month free
# EMAIL_ELASTICEMAIL_API_KEY=""
# EMAIL_ELASTICEMAIL_FROM="hello@example.com"

# Resend — already integrated
# RESEND_API_KEY=""

# Custom SMTP — bring your own server
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
