# Alaminn.info — Production Environment (TEMPLATE)
# Copy to .env and fill in real values:  cp .env.production.example .env && nano .env
# The real .env is gitignored — NEVER commit real secrets.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ─── Application Core ──────────────────────────────────────────────
APP_ENV="production"
NODE_ENV="production"
APP_DEBUG="false"
# Standalone server port (deploy/alaminn-info.service sets PORT=3056)
PORT="3056"
NEXT_PUBLIC_SITE_URL="https://alaminn.info"

# ─── Database (MySQL/MariaDB via Prisma) ──────────────────────────
# Prisma uses the MySQL provider schema (prisma/schema.mysql.prisma) on this
# host; the driver adapter (adapter-mariadb) is selected automatically from
# the mysql:// scheme. See deploy/mariadb-init.sql for DB/user creation.
DB_CONNECTION="mysql"
DB_HOST="localhost"
DB_PORT="3306"
DB_DATABASE="__DB_NAME__"
DB_USERNAME="__DB_USER__"
DB_PASSWORD="__DB_PASSWORD__"
DB_CHARSET="utf8mb4"
DB_COLLATION="utf8mb4_unicode_ci"
DATABASE_URL="mysql://__DB_USER__:__DB_PASSWORD__@localhost:3306/__DB_NAME__"

# ─── Authentication & Security ─────────────────────────────────────
# Generate with:  openssl rand -hex 32
# AUTH_SECRET must be at least 32 bytes (enforced at startup by src/lib/auth.ts).
AUTH_SECRET="__GENERATE_openssl_rand_hex_32__"
# Staff/UCI session HMAC secret (falls back to AUTH_SECRET when unset).
SESSION_SECRET="__GENERATE_openssl_rand_hex_32__"
NEXTAUTH_SECRET="__GENERATE_openssl_rand_hex_32__"
NEXTAUTH_URL="https://alaminn.info"
# Shared secret for the external scheduler hitting /api/cron/* endpoints.
# All cron endpoints FAIL CLOSED with 503 when this is unset (src/lib/cron-auth.ts).
CRON_SECRET="__GENERATE_openssl_rand_hex_32__"
# OTP exposure is a DEV-only helper — MUST be "false" (or unset) in production.
AUTH_EXPOSE_RESET_OTP="false"

# ─── Universal Messaging Channel (mini-service on :3010) ──────────
# Run with the bundled unit: deploy/alaminn-umc.service
UMC_URL="http://127.0.0.1:3010"

# ─── Email (REQUIRED: the app refuses to boot in production without it) ──
EMAIL_FROM="Al Aminn <noreply@alaminn.info>"
EMAIL_REPLY_TO="Al Aminn <hello@alaminn.info>"
SMTP_HOST="127.0.0.1"
SMTP_PORT="25"
SMTP_USER=""
SMTP_PASS=""

# ─── Primary Admin Credentials (seed-admin.ts / prisma/seed.ts) ───
# Used once to bootstrap the OWNER account; rotate after first sign-in.
ADMIN_EMAIL="admin@alaminn.info"
ADMIN_PASSWORD="__STRONG_PASSWORD__"
ADMIN_NAME="Al Aminn"
ADMIN_BOOTSTRAP_EMAIL="admin@alaminn.info"
ADMIN_BOOTSTRAP_PASSWORD="__STRONG_PASSWORD__"
