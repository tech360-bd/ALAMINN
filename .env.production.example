# Alaminn.info — Production Environment (TEMPLATE)
# Copy to .env and fill in real values:  cp .env.production.example .env && nano .env
# The real .env is gitignored — NEVER commit real secrets.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ─── Application Core ──────────────────────────────────────────────
APP_ENV="production"
NODE_ENV="production"
APP_DEBUG="false"
# Standalone server port (deploy/alaminn-info.service sets PORT=3056)
PORT="3056"
NEXT_PUBLIC_SITE_URL="https://alaminn.info"

# ─── Database (MySQL/MariaDB via Prisma) ──────────────────────────
# Prisma uses the MySQL provider schema (prisma/schema.mysql.prisma) on this
# host; the driver adapter (adapter-mariadb) is selected automatically from
# the mysql:// scheme. See deploy/mariadb-init.sql for DB/user creation.
DB_CONNECTION="mysql"
DB_HOST="localhost"
DB_PORT="3306"
DB_DATABASE="__DB_NAME__"
DB_USERNAME="__DB_USER__"
DB_PASSWORD="__DB_PASSWORD__"
DB_CHARSET="utf8mb4"
DB_COLLATION="utf8mb4_unicode_ci"
DATABASE_URL="mysql://__DB_USER__:__DB_PASSWORD__@localhost:3306/__DB_NAME__"

# ─── Authentication & Security ─────────────────────────────────────
# Generate with:  openssl rand -hex 32
# AUTH_SECRET must be at least 32 bytes (enforced at startup by src/lib/auth.ts).
AUTH_SECRET="__GENERATE_openssl_rand_hex_32__"
# Staff/UCI session HMAC secret (falls back to AUTH_SECRET when unset).
SESSION_SECRET="__GENERATE_openssl_rand_hex_32__"
NEXTAUTH_SECRET="__GENERATE_openssl_rand_hex_32__"
NEXTAUTH_URL="https://alaminn.info"
# Shared secret for the external scheduler hitting /api/cron/* endpoints.
# All cron endpoints FAIL CLOSED with 503 when this is unset (src/lib/cron-auth.ts).
CRON_SECRET="__GENERATE_openssl_rand_hex_32__"
# Staff password recovery sends mail to the registered inbox only.

# ─── Universal Messaging Channel (mini-service on :3010) ──────────
# Run with the bundled unit: deploy/alaminn-umc.service
UMC_SERVICE_URL="http://127.0.0.1:3010"

# ─── Email (REQUIRED: the app refuses to boot in production without it) ──
EMAIL_FROM="Al Aminn <noreply@alaminn.info>"
EMAIL_REPLY_TO="Al Aminn <hello@alaminn.info>"
SMTP_HOST="127.0.0.1"
SMTP_PORT="25"
SMTP_USER=""
SMTP_PASS=""

# ─── Primary Admin Credentials (seed-admin.ts / prisma/seed.ts) ───
# Used once to bootstrap the OWNER account; rotate after first sign-in.
ADMIN_EMAIL="admin@alaminn.info"
ADMIN_PASSWORD="__STRONG_PASSWORD__"
ADMIN_NAME="Al Aminn"
ADMIN_BOOTSTRAP_EMAIL="admin@alaminn.info"
ADMIN_BOOTSTRAP_PASSWORD="__STRONG_PASSWORD__"

# ─── Email: Optional Alternate Providers (multi-provider failover) ──
# The app falls back through providers in a configured order; keys below are
# OPTIONAL — set only the ones you use. DB-stored keys (Admin → Integrations)
# always take precedence over these env keys. Without any key the app still
# boots: local SMTP above and dev-mode logging remain available.
# EMAIL_PREFERRED_PROVIDER: sparkpost|mailgun|sendgrid|mailjet|sendinblue|
#   sendpulse|pepipost|elasticemail|resend|smtp|dev-null|auto (default: sparkpost)
#EMAIL_PREFERRED_PROVIDER="auto"
#EMAIL_SPARKPOST_API_KEY=""
#EMAIL_MAILGUN_API_KEY=""
#EMAIL_MAILGUN_DOMAIN=""
#EMAIL_SENDGRID_API_KEY=""
#EMAIL_MAILJET_API_KEY=""
#EMAIL_MAILJET_SECRET_KEY=""
#EMAIL_SENDINBLUE_API_KEY=""
#EMAIL_SENDPULSE_CLIENT_ID=""
#EMAIL_SENDPULSE_CLIENT_SECRET=""
#EMAIL_PEPIPOST_API_KEY=""
#EMAIL_ELASTICEMAIL_API_KEY=""
# RESEND_API_KEY=""            (already active if set — see src/lib/email/providers.ts)

# ─── SMS: Optional Provider Keys (consent-gated failover gateway) ──
# Same pattern as email: optional, DB-stored keys win. Provider order:
# httpSMS → Textbelt → Twilio → Plivo → dev mode (logs instead of sending).
# SMS_PREFERRED_PROVIDER: httpsms|textbelt|twilio|plivo|auto (default: httpsms)
#SMS_PREFERRED_PROVIDER="auto"
#SMS_HTTPSMS_API_KEY=""
#SMS_HTTPSMS_BASE_URL=""
#SMS_TEXTBELT_KEY=""
#SMS_TWILIO_ACCOUNT_SID=""
#SMS_TWILIO_AUTH_TOKEN=""
#SMS_PLIVO_AUTH_ID=""
#SMS_PLIVO_AUTH_TOKEN=""
# Per-provider sender ID / from-number overrides (SMS_<PROVIDER>_FROM):
#SMS_HTTPSMS_FROM=""
#SMS_TEXTBELT_FROM=""
#SMS_TWILIO_FROM=""
#SMS_PLIVO_FROM=""

# ─── WhatsApp, Sessions & Ops (all optional) ───────────────────────
# Shared secret verifying inbound WhatsApp/webhook callbacks (HMAC).
#WHATSAPP_WEBHOOK_SECRET="__GENERATE_openssl_rand_hex_32__"
# Hours before unused password-reset codes are purged by /api/cron/session-cleanup.
#RESET_CODE_RETENTION_HOURS="24"
# Bootstrap credentials for scripts/bootstrap-staff.ts (staff/UCI accounts).
#STAFF_BOOTSTRAP_EMAIL=""
#STAFF_BOOTSTRAP_NAME=""
#STAFF_BOOTSTRAP_PASSWORD=""
# Separate DATABASE_URL used by scripts/release-backup.mjs to verify a restored
# backup (defaults to DATABASE_URL when unset).
#BACKUP_VERIFY_DATABASE_URL=""
# Public LinkedIn profile URL shown in the endorsements section.
#NEXT_PUBLIC_LINKEDIN_URL=""

# ─── Internal AI Mini-Service (server-ai-service.ts) ───────────────
# Bind address/port for the optional local AI helper process.
#AI_SERVICE_HOST="127.0.0.1"
#AI_SERVICE_PORT="8765"
