{
  "name": "alaminn-info",
  "version": "1.0.0",
  "private": true,
  "description": "alaminn.info — Premium executive authority platform for Al Aminn (Next.js 16 standalone production build)",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "node .next/standalone/server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/prisma-generate.mjs",
    "db:push": "node scripts/prisma-generate.mjs db push",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:validate": "node scripts/prisma-generate.mjs validate",
    "db:migrate": "node scripts/prisma-generate.mjs migrate dev",
    "db:migrate:deploy": "node scripts/prisma-generate.mjs migrate deploy",
    "db:migrate:status": "node scripts/prisma-generate.mjs migrate status",
    "db:reset": "node scripts/prisma-generate.mjs migrate reset",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:backup": "npx tsx scripts/backup-db.ts",
    "db:restore": "npx tsx scripts/restore-db.ts",
    "db:verify": "npx tsx scripts/verify-db.ts",
    "security:test": "npx tsx scripts/security-tests.ts",
    "images:blur": "npx tsx scripts/generate-blur-placeholders.ts",
    "images:modern": "npx tsx scripts/generate-modern-images.ts",
    "images:optimize": "npx tsx scripts/generate-blur-placeholders.ts && npx tsx scripts/generate-modern-images.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/lib",
    "test:integration": "vitest run tests/api",
    "test:security": "npx tsx scripts/security-tests.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:production": "bash scripts/verify-production.sh",
    "docker:build": "docker build -t alaminn-info .",
    "docker:run": "docker run -d --name alaminn-app -p 3000:3000 --env-file .env alaminn-info",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:seed:universities": "npx tsx prisma/seed-higher-study-more.ts",
    "test:live": "node tests/run_all.mjs",
    "test:live:reset": "python3 scripts/reset_test_auth.py && node tests/run_all.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.1.1",
    "@libsql/client": "^0.18.0",
    "@mdxeditor/editor": "^4.5.0",
    "@prisma/adapter-libsql": "^6.19.0",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "6.19.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-email/components": "^1.0.12",
    "@reactuses/core": "^6.0.5",
    "@tanstack/react-query": "^5.82.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "18.0.9",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^14.12.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.525.0",
    "next": "^16.4.5",
    "next-intl": "^4.9.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.4",
    "prisma": "7.10.1",
    "react": "^19.3.1",
    "react-day-picker": "^9.8.0",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.11",
    "react-hook-form": "^7.60.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "react-syntax-highlighter": "^15.6.1",
    "recharts": "^2.15.4",
    "sharp": "^0.35.5",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "vaul": "^1.1.2",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zod": "^4.6.7",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.65.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
